@{
    ViewData["Title"] = "Advance Payment Successful";
}
<div class="public-marketplace-page">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 text-center">
                    <div class="card-body p-5">
                        <div class="display-3 text-success"><i class="fa-solid fa-circle-check"></i></div>
                        <h1 class="h2 fw-bold mt-3">Advance payment confirmed</h1>
                        <p class="text-muted">Application #@ViewBag.ApplicationId has been processed successfully.</p>
                        <p class="mb-4">For a To-Let, the tenant account and flat assignment are created automatically and login details are emailed. For a flat sale, the flat remains reserved while management completes the legal/offline ownership process.</p>
                        <a asp-controller="Property" asp-action="Index" class="btn btn-primary rounded-pill px-4">Back to marketplace</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
