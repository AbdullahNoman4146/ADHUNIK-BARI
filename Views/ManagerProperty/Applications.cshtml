@model IEnumerable<ADHUNIK_BARI.Models.PropertyApplication>
@{
    ViewData["Title"] = "Property Applications";
}
<div class="property-page container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="property-eyebrow"><i class="fa-solid fa-users me-2"></i>Marketplace</div>
            <h1 class="h2 fw-bold mb-1">Property Applications</h1>
            <p class="text-muted mb-0">Advance-payment and reservation history is kept separately from resident bill payments.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to listings</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="fa-solid fa-inbox fa-3x text-muted"></i>
            <h2 class="h5 fw-bold mt-3">No applications yet</h2>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Applicant</th><th>Property</th><th>Type</th><th>Advance</th><th>Payment</th><th>Status</th><th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4"><strong>@item.FullName</strong><div class="small text-muted">@item.Email · @item.Phone</div></td>
                            <td><strong>@item.PropertyListing?.Title</strong><div class="small text-muted">Flat @item.PropertyListing?.Flat?.FlatNumber</div></td>
                            <td>@(item.ApplicationType == PropertyListingTypes.ToLet ? "To-Let" : "For Sale")</td>
                            <td>৳@item.AdvanceAmount.ToString("N0")</td>
                            <td><span class="badge @(item.PaymentStatus == PropertyPaymentStatuses.Succeeded ? "bg-success" : item.PaymentStatus == PropertyPaymentStatuses.Failed ? "bg-danger" : "bg-secondary")">@item.PaymentStatus</span></td>
                            <td><span class="badge bg-light text-dark border">@item.Status</span>@if (!string.IsNullOrWhiteSpace(item.FailureReason)){<div class="small text-danger mt-1">@item.FailureReason</div>}</td>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
