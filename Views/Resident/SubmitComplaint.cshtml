@model ADHUNIK_BARI.ViewModels.SubmitComplaintViewModel
@{ ViewData["Title"] = "New service request"; }
<div class="ab-app-page"><header class="ab-page-heading ab-page-heading-compact"><div><div class="ab-page-kicker"><span></span>Resident care</div><h1>Tell us what <em>needs attention.</em></h1><p>Submit a detailed request and the management team can start resolving it.</p></div></header>
<section class="ab-panel ab-form-shell"><aside class="ab-form-aside"><i class="fa-solid fa-screwdriver-wrench"></i><small>@(ViewBag.FlatNumber != null ? $"Flat {ViewBag.FlatNumber}" : "Service desk")</small><h2>A clear report leads to a faster fix.</h2><p>Choose the closest category, describe what happened, and include a photo when it helps explain the issue.</p></aside>
<form asp-action="SubmitComplaint" method="post" enctype="multipart/form-data" class="ab-form-body"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="ab-field-grid">
<div class="ab-field-span-2"><label asp-for="Category" class="form-label">Issue category</label><select asp-for="Category" class="form-select"><option value="">Choose the closest category</option><option>Maintenance</option><option>Security</option><option>Plumbing</option><option>Electrical</option><option>Cleanliness</option><option>Other</option></select><span asp-validation-for="Category" class="text-danger small"></span></div>
<div class="ab-field-span-2"><label asp-for="Description" class="form-label">What happened?</label><textarea asp-for="Description" class="form-control" rows="7" placeholder="Describe the issue, where it is, and how urgent it feels…"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
<div class="ab-field-span-2"><label asp-for="Image" class="form-label">Supporting image <span class="text-muted">· optional</span></label><div class="ab-upload-field"><i class="fa-solid fa-cloud-arrow-up"></i><input asp-for="Image" class="form-control" accept=".jpg,.jpeg,.png,.webp" /><small class="text-muted">JPG, PNG, or WebP · maximum 5 MB</small></div><span asp-validation-for="Image" class="text-danger small"></span></div>
</div><div class="ab-form-actions"><a asp-action="MyComplaints" class="ab-app-btn ab-app-btn-secondary">Cancel</a><button type="submit" class="ab-app-btn ab-app-btn-primary"><i class="fa-solid fa-paper-plane"></i>Submit request</button></div></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
