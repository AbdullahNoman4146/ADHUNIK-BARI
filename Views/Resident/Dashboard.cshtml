@{
    ViewData["Title"] = "My home";
    var assignment = ViewBag.Assignment as ADHUNIK_BARI.Models.FlatAssignment;
    var residentName = ViewBag.ResidentName as string ?? "Resident";
    var firstName = residentName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Resident";
}
<div class="ab-app-page ab-resident-dashboard">
    @if (ViewBag.RequirePasswordChange == true) { <div class="ab-security-banner"><span><i class="fa-solid fa-shield-halved"></i></span><div><strong>Secure your new account</strong><p>Replace your temporary password before continuing.</p></div><a asp-controller="Account" asp-action="ChangePassword">Update password <i class="fa-solid fa-arrow-right"></i></a></div> }
    <header class="ab-page-heading" data-reveal><div><div class="ab-page-kicker"><span></span> Your resident space</div><h1>Welcome home, <em>@firstName.</em></h1><p>Your apartment, payments and community updates are all in one calm place.</p></div><a class="ab-app-btn ab-app-btn-primary" asp-action="SubmitComplaint"><i class="fa-solid fa-plus"></i> New service request</a></header>

    @if (assignment != null)
    {
        <section class="ab-home-overview" data-reveal>
            <div class="ab-home-visual"><div class="ab-home-visual-image"></div><div class="ab-home-visual-wash"></div><div class="ab-home-status"><i></i> Active residence</div><div class="ab-home-title"><span>YOUR HOME</span><h2>Flat @assignment.Flat?.FlatNumber</h2><p>Floor @assignment.Flat?.FloorNumber · ADHUNIK BARI</p></div></div>
            <div class="ab-home-details">
                <div class="ab-panel-head">
                    <div><span class="ab-panel-kicker">RESIDENCE PROFILE</span><h2>Apartment details</h2></div>
                    <span class="ab-status ab-status-success"><i></i> Occupied</span>
                </div>
                <dl>
                    <div><dt>Flat number</dt><dd>@(assignment.Flat?.FlatNumber ?? "—")</dd></div>
                    <div><dt>Floor</dt><dd>@(assignment.Flat?.FloorNumber.ToString() ?? "—")</dd></div>
                    <div><dt>Resident type</dt><dd>@assignment.ResidentType</dd></div>
                    <div><dt>Member since</dt><dd>@assignment.AssignmentDate.ToString("dd MMM yyyy")</dd></div>
                </dl>

                @{
                    var residentParking = ViewBag.ResidentParking as ADHUNIK_BARI.ViewModels.ResidentParkingViewModel;
                }
                @if (residentParking != null && residentParking.HasAssignedParking)
                {
                    foreach (var p in residentParking.Spots)
                    {
                        <div class="ab-resident-parking-card">
                            <div class="ab-resident-parking-head">
                                <h3><i class="fa-solid fa-square-parking text-success"></i> My Parking</h3>
                                <span class="badge @(p.PaymentStatus == "Paid" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") fw-bold" style="font-size:11px;">
                                    <i class="fa-solid fa-circle-dot me-1"></i>@p.PaymentStatus
                                </span>
                            </div>
                            <dl class="ab-resident-parking-details">
                                <div>
                                    <dt>Spot Number</dt>
                                    <dd class="text-primary">@p.SpotNumber</dd>
                                </div>
                                <div>
                                    <dt>Floor</dt>
                                    <dd>@p.FloorName</dd>
                                </div>
                                <div>
                                    <dt>Type</dt>
                                    <dd>Reserved (@p.VehicleType)</dd>
                                </div>
                                <div>
                                    <dt>Monthly Fee</dt>
                                    <dd>@p.MonthlyFee.ToString("N0") BDT</dd>
                                </div>
                                <div>
                                    <dt>Payment Status</dt>
                                    <dd class="@(p.PaymentStatus == "Paid" ? "text-success" : "text-danger")">@p.PaymentStatus</dd>
                                </div>
                            </dl>
                        </div>
                    }
                }
                else
                {
                    <div class="ab-resident-parking-card" style="background:#f8faf8;">
                        <div class="ab-resident-parking-head mb-1">
                            <h3 class="text-muted" style="font-size:14px;"><i class="fa-solid fa-square-parking text-muted"></i> My Parking</h3>
                            <span class="text-muted small">No spot assigned</span>
                        </div>
                        <p class="small text-muted mb-2">You currently do not have a dedicated basement parking space.</p>
                        <a asp-controller="Property" asp-action="Index" asp-route-type="Parking" class="btn btn-sm btn-outline-success rounded-pill">
                            <i class="fa-solid fa-square-parking me-1"></i> Browse &amp; Book Parking
                        </a>
                    </div>
                }

                <div class="ab-home-assurance mt-3"><i class="fa-solid fa-circle-check"></i><span><strong>Your assignment is active</strong><small>Building services and resident tools are available.</small></span></div>
            </div>
        </section>
    }
    else
    {
        <section class="ab-panel ab-assignment-empty" data-reveal><span><i class="fa-solid fa-house-circle-exclamation"></i></span><div><h2>No active flat assignment</h2><p>Your manager needs to connect this account to a flat before residence details can appear.</p></div></section>
    }

    <section class="ab-resident-actions" data-reveal>
        <a class="ab-resident-action ab-action-featured" asp-action="MyBills"><span class="ab-action-icon"><i class="fa-solid fa-wallet"></i></span><div><small>FINANCES</small><h2>Bills & payments</h2><p>Review charges, pay securely and access receipts.</p></div><i class="fa-solid fa-arrow-right"></i><div class="ab-action-glow"></div></a>
        <a class="ab-resident-action" asp-action="Notices"><span class="ab-action-icon"><i class="fa-solid fa-bell"></i></span><div><small>COMMUNITY</small><h2>Notices</h2><p>Stay informed about your building.</p></div><i class="fa-solid fa-arrow-right"></i></a>
        <a class="ab-resident-action" asp-action="MyComplaints"><span class="ab-action-icon"><i class="fa-solid fa-clipboard-check"></i></span><div><small>SERVICE</small><h2>My requests</h2><p>Track maintenance and support issues.</p></div><i class="fa-solid fa-arrow-right"></i></a>
        <a class="ab-resident-action" asp-action="Cctv"><span class="ab-action-icon"><i class="fa-solid fa-video"></i></span><div><small>SURVEILLANCE</small><h2>CCTV Live Feeds</h2><p>Watch building gates, lobby & parking live.</p></div><i class="fa-solid fa-arrow-right"></i></a>
        <a class="ab-resident-action" asp-action="Gym"><span class="ab-action-icon"><i class="fa-solid fa-dumbbell"></i></span><div><small>WELLNESS</small><h2>Fitness &amp; Gym</h2><p>View facility hours, manage pass &amp; dues.</p></div><i class="fa-solid fa-arrow-right"></i></a>
        <a class="ab-resident-action" asp-controller="Account" asp-action="ChangePassword"><span class="ab-action-icon"><i class="fa-solid fa-shield-halved"></i></span><div><small>SECURITY</small><h2>Account safety</h2><p>Update your password and credentials.</p></div><i class="fa-solid fa-arrow-right"></i></a>
    </section>

    <section class="ab-resident-footer-card" data-reveal><div><span class="ab-panel-kicker">NEED A HAND?</span><h2>Something in your home needs attention?</h2><p>Send a clear request with a photo and follow every update from your dashboard.</p></div><a class="ab-app-btn ab-app-btn-light" asp-action="SubmitComplaint">Submit a request <i class="fa-solid fa-arrow-right"></i></a></section>
</div>
