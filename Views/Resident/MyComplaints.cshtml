@model ADHUNIK_BARI.ViewModels.MyComplaintsViewModel
@{
    ViewData["Title"] = "My Complaints";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="mb-1">My Complaints</h1><p class="text-muted mb-0">Track issues submitted for your assigned flat.</p></div>
        <a asp-action="SubmitComplaint" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>New Complaint</a>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }
    @if (Model.FlatNumber != null) { <div class="small text-muted mb-3"><i class="fa-solid fa-house me-2"></i>Assigned flat: <strong>@Model.FlatNumber</strong></div> }
    <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Complaint</th><th>Description</th><th>Status</th><th>Submitted</th><th>Attachment</th></tr></thead>
        <tbody>
        @foreach (var complaint in Model.Complaints)
        {
            var statusClass = complaint.ComplaintStatus switch { "Solved" => "text-bg-success", "In Progress" => "text-bg-info", _ => "text-bg-warning" };
            <tr><td><span class="fw-semibold">@complaint.Category</span></td><td class="text-break" style="min-width:240px;max-width:420px;">@complaint.Description</td><td><span class="badge @statusClass">@complaint.ComplaintStatus</span>@if (!string.IsNullOrWhiteSpace(complaint.ManagerNote)) { <div class="small text-muted mt-1">Note: @complaint.ManagerNote</div> }</td><td>@complaint.CreatedAt.ToString("dd MMM yyyy")</td><td>@if (!string.IsNullOrWhiteSpace(complaint.ImagePath)) { <a href="@complaint.ImagePath" target="_blank" rel="noopener">View image</a> } else { <span class="text-muted">None</span> }</td></tr>
        }
        @if (!Model.Complaints.Any()) { <tr><td colspan="5" class="text-center text-muted py-5">No complaints found for your assigned flat.</td></tr> }
        </tbody>
    </table></div></div>
</div>