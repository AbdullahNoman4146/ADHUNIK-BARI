@model ReceiptViewModel

@{
    ViewData["Title"] = "Payment Receipt";
}

<style>
    .receipt-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
    }

    .receipt-header {
        text-align: center;
        border-bottom: 2px solid #333;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .receipt-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: bold;
        color: #333;
    }

    .receipt-header p {
        margin: 5px 0 0 0;
        color: #666;
        font-size: 14px;
    }

    .receipt-number {
        text-align: right;
        font-weight: bold;
        margin: 10px 0;
        color: #555;
    }

    .receipt-details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
        padding: 15px;
        background: #f9f9f9;
        border-radius: 5px;
    }

    .detail-group {
        display: flex;
        flex-direction: column;
    }

    .detail-label {
        font-weight: bold;
        color: #333;
        font-size: 12px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #666;
        font-size: 14px;
    }

    .resident-info-card {
        background: #f0f7ff;
        border-left: 4px solid #007bff;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 4px;
    }

    .resident-info-card h5 {
        margin: 0 0 10px 0;
        color: #007bff;
        font-size: 14px;
        text-transform: uppercase;
        font-weight: bold;
    }

    .resident-info-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .resident-info-row:last-child {
        margin-bottom: 0;
    }

    .info-label {
        font-weight: 600;
        color: #333;
    }

    .info-value {
        color: #666;
    }

    .items-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
        border-top: 2px solid #333;
        border-bottom: 2px solid #333;
    }

    .items-table thead {
        background: #f0f0f0;
    }

    .items-table th {
        padding: 12px;
        text-align: left;
        font-weight: bold;
        color: #333;
        border-bottom: 1px solid #ddd;
        font-size: 13px;
        text-transform: uppercase;
    }

    .items-table td {
        padding: 12px;
        border-bottom: 1px solid #eee;
        font-size: 14px;
        color: #666;
    }

    .items-table tr:last-child td {
        border-bottom: 2px solid #333;
    }

    .item-amount {
        text-align: right;
        font-weight: 500;
    }

    .items-table tbody tr:hover {
        background: #fafafa;
    }

    .payment-summary {
        margin-bottom: 30px;
        padding: 20px;
        background: #f8f8f8;
        border-radius: 5px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .summary-row.total {
        border-top: 2px solid #333;
        padding-top: 10px;
        margin-top: 10px;
        font-weight: bold;
        font-size: 16px;
        color: #333;
    }

    .payment-status-badge {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 12px;
        text-transform: uppercase;
    }

    .payment-status-badge.completed {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .footer-section {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #ddd;
        text-align: center;
        font-size: 12px;
        color: #999;
    }

    .footer-section p {
        margin: 5px 0;
    }

    .transaction-info {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 12px;
        margin-bottom: 20px;
        border-radius: 4px;
        font-size: 13px;
    }

    .transaction-info strong {
        color: #856404;
        display: block;
        margin-bottom: 5px;
    }

    .transaction-info p {
        margin: 3px 0;
        color: #856404;
    }

    /* Print Styles */
    @@media print {
        * {
            margin: 0;
            padding: 0;
        }

        body {
            background: white;
            font-family: Arial, sans-serif;
        }

        .receipt-container {
            border: none;
            box-shadow: none;
            max-width: 100%;
            margin: 0;
            padding: 20px;
        }

        /* Hide navigation bar and footer */
        .navbar,
        footer,
        .no-print,
        .btn,
        button {
            display: none !important;
        }

        .receipt-header {
            page-break-after: avoid;
        }

        .items-table {
            page-break-inside: avoid;
        }

        .payment-summary {
            page-break-inside: avoid;
        }

        .transaction-info {
            background: #f0f0f0;
            border-left: 4px solid #999;
        }

        .transaction-info strong,
        .transaction-info p {
            color: #333;
        }

        /* Ensure proper spacing for print */
        .detail-value,
        .info-value {
            color: #000;
        }

        /* Print in color but ensure readability */
        .receipt-header h1 {
            color: #000;
        }

        a {
            text-decoration: none;
            color: #000;
        }
    }

    .print-button-group {
        margin-bottom: 20px;
        text-align: right;
    }

    .print-button-group .btn {
        margin-left: 10px;
    }
</style>

<div class="container mt-5 no-print">
    <div class="print-button-group">
        <a href="javascript:window.history.back();" class="btn btn-secondary">Back</a>
        <button onclick="window.print();" class="btn btn-primary">
            <i class="fas fa-print"></i> Print Receipt / Save as PDF
        </button>
    </div>
</div>

<div class="receipt-container">
    <!-- Receipt Header -->
    <div class="receipt-header">
        <h1>@Model.OrganizationName</h1>
        <p>@Model.OrganizationSubtitle</p>
        <div class="receipt-number">Receipt #@Model.ReceiptNumber</div>
    </div>

    <!-- Payment DateTime and Transaction Info -->
    <div class="transaction-info">
        <strong>Payment Details:</strong>
        <p><strong>Date & Time:</strong> @Model.PaymentDateTime.ToString("dddd, MMMM d, yyyy h:mm:ss tt")</p>
        <p><strong>Transaction ID:</strong> @Model.TransactionId</p>
        <p><strong>Status:</strong> <span class="payment-status-badge completed">@Model.PaymentStatus</span></p>
    </div>

    <!-- Resident Information Card -->
    <div class="resident-info-card">
        <h5>Resident Information</h5>
        <div class="resident-info-row">
            <div>
                <span class="info-label">Name:</span>
                <span class="info-value">@Model.ResidentName</span>
            </div>
            <div>
                <span class="info-label">Role:</span>
                <span class="info-value">@Model.ResidentRole</span>
            </div>
        </div>
        <div class="resident-info-row">
            <div>
                <span class="info-label">Flat Number:</span>
                <span class="info-value">@Model.FlatNumber</span>
            </div>
            <div>
                <span class="info-label">Floor Number:</span>
                <span class="info-value">@Model.FloorNumber</span>
            </div>
        </div>
        <div class="resident-info-row">
            <div>
                <span class="info-label">Email:</span>
                <span class="info-value">@Model.ResidentEmail</span>
            </div>
            <div>
                <span class="info-label">Phone:</span>
                <span class="info-value">@Model.ResidentPhone</span>
            </div>
        </div>
        <div class="resident-info-row">
            <div>
                <span class="info-label">Billing Period:</span>
                <span class="info-value">@Model.BillingMonth/@Model.BillingYear</span>
            </div>
        </div>
    </div>

    <!-- Itemized Charges Table -->
    @if (Model.PaidItems.Any())
    {
        <table class="items-table">
            <thead>
                <tr>
                    <th>Charge Type</th>
                    <th>Description</th>
                    <th class="text-right">Amount (BDT)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PaidItems)
                {
                    <tr>
                        <td>@item.ItemType</td>
                        <td>@item.Description</td>
                        <td class="item-amount">
                            @item.Amount.ToString("F2")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No itemized charges available for this payment.
        </div>
    }

    <!-- Payment Summary Section -->
    <div class="payment-summary">
        <div class="summary-row">
            <span>Number of Items Paid:</span>
            <strong>@Model.PaidItems.Count</strong>
        </div>
        <div class="summary-row total">
            <span>Total Amount Paid:</span>
            <strong>৳ @Model.TotalAmountPaid.ToString("F2")</strong>
        </div>
    </div>

    <!-- Stripe Receipt Link (if available) -->
    @if (!string.IsNullOrEmpty(Model.StripeReceiptUrl))
    {
        <div class="transaction-info">
            <p>
                <strong>Official Stripe Receipt:</strong><br />
                <a href="@Model.StripeReceiptUrl" target="_blank" rel="noopener noreferrer">
                    View Full Transaction Details
                </a>
            </p>
        </div>
    }

    <!-- Footer -->
    <div class="footer-section">
        <p><strong>ADHUNIK BARI</strong></p>
        <p>Residential Management System</p>
        <p>Generated on: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
        <p>This is an official receipt. Please retain for your records.</p>
    </div>
</div>

@section Scripts {
    <script>
        // Allow users to print or save as PDF
        document.addEventListener('DOMContentLoaded', function () {
            // Nothing needed here, print button uses window.print()
        });
    </script>
}
