@model IEnumerable<ADHUNIK_BARI.Models.Notice>
@{ ViewData["Title"] = "Notices"; }
<div class="ab-app-page">
    <header class="ab-page-heading ab-page-heading-compact"><div><div class="ab-page-kicker"><span></span>Your community</div><h1>Stay in the <em>know.</em></h1><p>Building announcements and updates selected for your apartment.</p></div></header>
    @if (Model.Any()) { <section class="ab-notice-grid">@foreach (var notice in Model) { <article class="ab-notice-card"><div class="ab-notice-card-head"><span class="ab-notice-kind"><i class="fa-solid @(notice.NoticeType == "General" ? "fa-earth-asia" : "fa-house")"></i>@(notice.NoticeType == "General" ? "Community" : "Your flat")</span><time datetime="@notice.CreatedAt.ToString("O")">@notice.CreatedAt.ToString("dd MMM yyyy")</time></div><h2>@notice.Title</h2><p>@notice.Description</p><footer class="ab-notice-card-foot"><span class="ab-notice-audience"><i class="fa-solid fa-building-shield"></i>ADHUNIK BARI</span><span class="ab-status ab-status-success"><i></i>New update</span></footer></article> }</section> }
    else { <section class="ab-panel ab-empty-state-app"><i class="fa-solid fa-bell-slash"></i><h2>All quiet for now</h2><p>There are no active notices for your apartment. New updates will appear here.</p></section> }
</div>
