@model ADHUNIK_BARI.ViewModels.GymIdCardViewModel
@{
    ViewData["Title"] = "My Gym Membership Card";
}

<div class="container py-4 fade-in">
    <!-- Non-print Action Header -->
    <div class="no-print d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <div class="text-uppercase text-primary fw-bold small tracking-wide">
                <i class="fa-solid fa-id-card me-1"></i> My Credentials
            </div>
            <h1 class="h3 fw-bold text-dark mb-0">My Gym Membership ID Card</h1>
            <p class="text-muted small mb-0">Present this digital or printed pass when visiting the building gym.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary rounded-3 px-4 shadow-sm fw-bold" onclick="window.print();">
                <i class="fa-solid fa-print me-2"></i> Print My ID Card
            </button>
            <a asp-controller="Resident" asp-action="Gym" class="btn btn-outline-secondary rounded-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Gym Center
            </a>
        </div>
    </div>

    <!-- Active Membership Notice -->
    <div class="no-print alert alert-success-subtle border border-success-subtle rounded-4 mb-4 p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="p-2 bg-success text-white rounded-circle fs-4">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <strong class="text-success-emphasis d-block">Active & Paid Membership Pass</strong>
                <small class="text-muted">
                    Your gym pass is valid until <strong class="text-danger">@Model.ExpiryDate.ToString("MMMM dd, yyyy")</strong>. You can print this card or show it on your mobile device at the gym reception.
                </small>
            </div>
        </div>
        <div>
            <button type="button" class="btn btn-sm btn-success rounded-3" onclick="window.print();">
                <i class="fa-solid fa-print me-1"></i> Print ID Card
            </button>
        </div>
    </div>

    <!-- Printable Card Partial -->
    <partial name="_GymIdCardContent" model="Model" />

    <!-- Print Tips Notice -->
    <div class="no-print text-center text-muted small mt-3">
        <i class="fa-solid fa-circle-info text-primary me-1"></i> Tip: You can save this card as a PDF or print it out to keep in your wallet/gym bag.
    </div>
</div>
