@model ADHUNIK_BARI.ViewModels.LoginViewModel


@{
    ViewData["Title"] = "Login";
}



<div class="login-page">



    <!-- Animated Background -->

    <div class="ambient-circle circle-one"></div>

    <div class="ambient-circle circle-two"></div>

    <div class="ambient-circle circle-three"></div>






    <div class="login-glass-card">



        <div class="login-header">


            <div class="login-logo">
                AB
            </div>


            <h1>
                ADHUNIK BARI
            </h1>


            <p>
                Smart Apartment Management System
            </p>


        </div>





        <form asp-action="Login"
              method="post"
              id="loginForm">





            <div class="floating-input">


                <input asp-for="Email"
                       id="email"
                       placeholder=" " />


                <label>
                    Email Address
                </label>


            </div>






            <div class="floating-input">


                <input asp-for="Password"
                       id="password"
                       type="password"
                       placeholder=" " />


                <label>
                    Password
                </label>


            </div>






            <button type="submit"
                    class="premium-login-btn">

                <span id="loginText" class="btn-text">
                    Login
                </span>

                <span id="spinner"
                      class="spinner">
                </span>

            </button>





        </form>



    </div>



</div>