@model ADHUNIK_BARI.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Secure your account";
}
<section class="ab-account-setup">
    <div class="container">
        <div class="ab-account-setup-card">
            <aside><span><i class="fa-solid fa-shield-halved"></i></span><div class="ab-eyebrow ab-eyebrow-light"><span></span> First sign-in</div><h1>Make this account yours.</h1><p>Replace the temporary password with one only you know.</p><ul><li>Use a unique password</li><li>Avoid personal details</li><li>Keep it private</li></ul></aside>
            <div class="ab-account-form">
                <h2>Set a new password</h2><p>Complete all three fields to continue.</p>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="ab-validation-summary" role="alert"></div>
                    <div class="ab-field"><label asp-for="OldPassword">Temporary password</label><div class="ab-input-wrap"><i class="fa-solid fa-key"></i><input asp-for="OldPassword" type="password" autocomplete="current-password" /><button type="button" class="ab-password-toggle" data-password-toggle aria-label="Show password"><i class="fa-regular fa-eye"></i></button></div><span asp-validation-for="OldPassword" class="text-danger small"></span></div>
                    <div class="ab-field"><label asp-for="NewPassword">New password</label><div class="ab-input-wrap"><i class="fa-solid fa-lock"></i><input asp-for="NewPassword" type="password" autocomplete="new-password" /><button type="button" class="ab-password-toggle" data-password-toggle aria-label="Show password"><i class="fa-regular fa-eye"></i></button></div><span asp-validation-for="NewPassword" class="text-danger small"></span></div>
                    <div class="ab-field"><label asp-for="ConfirmPassword">Confirm new password</label><div class="ab-input-wrap"><i class="fa-solid fa-lock"></i><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><button type="button" class="ab-password-toggle" data-password-toggle aria-label="Show password"><i class="fa-regular fa-eye"></i></button></div><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                    <button type="submit" class="ab-button ab-button-dark">Secure account <i class="fa-solid fa-arrow-right"></i></button>
                </form>
            </div>
        </div>
    </div>
</section>
