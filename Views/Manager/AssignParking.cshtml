@model ADHUNIK_BARI.Models.ParkingSpot



<div class="container mt-4">


<h2>
Assign Parking Spot
</h2>



<div class="card p-4">


<h5>

Parking Spot:
@Model.SpotNumber

</h5>



<form asp-action="AssignParking"
      method="post">



<input type="hidden"
       name="ParkingSpotId"
       value="@Model.ParkingSpotId" />



<div class="mb-3">


<label>
Select Flat
</label>


<select name="FlatId"
        class="form-control">


<option>
Select Flat
</option>


@foreach(var flat in ViewBag.Flats)
{

<option value="@flat.FlatId">

@flat.FlatNumber

</option>

}


</select>


</div>




<button class="btn btn-primary">

Assign Parking

</button>


</form>


</div>


</div>