@model ADHUNIK_BARI.ViewModels.EditFlatViewModel
@{ ViewData["Title"] = "Edit flat"; }
<div class="ab-app-page">
    <header class="ab-page-heading ab-page-heading-compact"><div><div class="ab-page-kicker"><span></span>Apartment record</div><h1>Edit flat <em>@Model.FlatNumber.</em></h1><p>Update unit details, rent, or current occupancy state.</p></div></header>
    <section class="ab-panel ab-form-shell">
        <aside class="ab-form-aside"><i class="fa-solid fa-pen-ruler"></i><small>Live record</small><h2>Keep the building directory precise.</h2><p>Changes here can affect billing and resident context. Confirm the occupancy state before saving.</p></aside>
        <form asp-action="EditFlat" method="post" class="ab-form-body"><input type="hidden" asp-for="FlatId" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="ab-field-grid">
            <div><label asp-for="FlatNumber" class="form-label">Flat number</label><input asp-for="FlatNumber" class="form-control" /><span asp-validation-for="FlatNumber" class="text-danger small"></span></div>
            <div><label asp-for="FloorNumber" class="form-label">Floor number</label><input asp-for="FloorNumber" class="form-control" type="number" min="0" /><span asp-validation-for="FloorNumber" class="text-danger small"></span></div>
            <div><label asp-for="MonthlyRent" class="form-label">Monthly tenant rent</label><div class="input-group"><span class="input-group-text">৳</span><input asp-for="MonthlyRent" class="form-control" type="number" min="0" step="100" /></div><span asp-validation-for="MonthlyRent" class="text-danger small"></span></div>
            <div><label asp-for="FlatStatus" class="form-label">Occupancy status</label><select asp-for="FlatStatus" class="form-select"><option value="Available">Available</option><option value="Occupied">Occupied</option></select><span asp-validation-for="FlatStatus" class="text-danger small"></span></div>
        </div><div class="ab-form-actions"><a asp-action="Flats" class="ab-app-btn ab-app-btn-secondary">Cancel</a><button type="submit" class="ab-app-btn ab-app-btn-primary"><i class="fa-solid fa-check"></i>Save changes</button></div></form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
