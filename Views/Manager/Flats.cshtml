@model IEnumerable<ADHUNIK_BARI.Models.Flat>
@{ ViewData["Title"] = "Flats & occupancy"; var occupied = Model.Count(f => f.FlatStatus == "Occupied"); var available = Model.Count() - occupied; }
<div class="ab-app-page">
    <header class="ab-page-heading ab-page-heading-compact">
        <div><div class="ab-page-kicker"><span></span>Property operations</div><h1>Flats &amp; <em>occupancy.</em></h1><p>Keep every apartment, rent setting, and resident assignment in one clear view.</p></div>
        <div class="ab-page-heading-actions"><a asp-action="AssignFlat" class="ab-app-btn ab-app-btn-secondary"><i class="fa-solid fa-user-plus"></i>Assign resident</a><a asp-action="CreateFlat" class="ab-app-btn ab-app-btn-primary"><i class="fa-solid fa-plus"></i>Add flat</a></div>
    </header>
    @if (TempData["Success"] != null) { <div class="alert alert-success ab-toast-alert" role="alert"><i class="fa-solid fa-circle-check"></i>@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert"><i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]</div> }
    <section class="ab-stat-strip" aria-label="Flat summary">
        <article class="ab-stat-chip"><span><i class="fa-solid fa-building"></i></span><div><strong>@Model.Count()</strong><small>Total flats</small></div></article>
        <article class="ab-stat-chip"><span><i class="fa-solid fa-key"></i></span><div><strong>@occupied</strong><small>Occupied</small></div></article>
        <article class="ab-stat-chip"><span><i class="fa-solid fa-door-open"></i></span><div><strong>@available</strong><small>Available</small></div></article>
    </section>
    <section class="ab-panel ab-data-panel">
        <div class="ab-panel-head"><div class="ab-table-title"><span><i class="fa-solid fa-city"></i></span><div><div class="ab-panel-kicker">LIVE INVENTORY</div><h2>Apartment directory</h2></div></div><div class="ab-panel-status"><i></i>@Model.Count() records</div></div>
        @if (Model.Any()) {
        <div class="table-responsive"><table class="table ab-app-table align-middle"><thead><tr><th>Apartment</th><th>Floor</th><th>Monthly rent</th><th>Status</th><th>Created</th><th class="text-end">Action</th></tr></thead><tbody>
        @foreach (var flat in Model) { <tr><td><div class="ab-unit-name"><span>@flat.FlatNumber</span><strong>Flat @flat.FlatNumber</strong></div></td><td>Floor @flat.FloorNumber</td><td><strong class="ab-money">৳@flat.MonthlyRent.ToString("N0")</strong><small class="ab-table-sub">Tenant rate / month</small></td><td><span class="ab-status @(flat.FlatStatus == "Occupied" ? "ab-status-warning" : "ab-status-success")"><i></i>@flat.FlatStatus</span></td><td>@flat.CreatedAt.ToString("dd MMM yyyy")</td><td class="text-end"><a asp-action="EditFlat" asp-route-id="@flat.FlatId" class="ab-icon-btn" aria-label="Edit flat @flat.FlatNumber"><i class="fa-solid fa-pen"></i></a></td></tr> }
        </tbody></table></div>
        } else { <div class="ab-empty-state-app"><i class="fa-solid fa-building-circle-exclamation"></i><h2>Your building is ready for its first flat</h2><p>Create an apartment record, then assign a resident when it is ready.</p><a asp-action="CreateFlat" class="ab-app-btn ab-app-btn-primary">Create first flat</a></div> }
    </section>
</div>
