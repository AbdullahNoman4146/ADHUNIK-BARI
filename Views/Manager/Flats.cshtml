@model IEnumerable<ADHUNIK_BARI.Models.Flat>
@{
    ViewData["Title"] = "Flat Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="mb-1">Flat Management</h1><p class="text-muted mb-0">Manage apartments and occupancy.</p></div>
        <div><a asp-action="AssignFlat" class="btn btn-outline-primary me-2">Assign Resident</a><a asp-action="CreateFlat" class="btn btn-primary">Create Flat</a></div>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Flat Number</th><th>Floor</th><th>Status</th><th>Created</th></tr></thead>
        <tbody>
        @foreach (var flat in Model)
        {
            <tr><td class="fw-semibold">@flat.FlatNumber</td><td>@flat.FloorNumber</td>
                <td><span class="badge @(flat.FlatStatus == "Occupied" ? "text-bg-warning" : "text-bg-success")">@flat.FlatStatus</span></td>
                <td>@flat.CreatedAt.ToString("dd MMM yyyy")</td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">No flats have been created yet.</td></tr> }
        </tbody>
    </table></div></div>
</div>