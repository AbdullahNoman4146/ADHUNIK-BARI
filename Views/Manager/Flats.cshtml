@model IEnumerable<ADHUNIK_BARI.Models.Flat>
@{
    ViewData["Title"] = "Flat Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="mb-1 fw-bold">Flat Management</h1>
            <p class="text-muted mb-0">Manage apartments, monthly rent configuration, and occupancy.</p>
        </div>
        <div>
            <a asp-action="AssignFlat" class="btn btn-outline-primary me-2">
                <i class="fa-solid fa-user-plus me-1"></i> Assign Resident
            </a>
            <a asp-action="CreateFlat" class="btn btn-primary">
                <i class="fa-solid fa-plus me-1"></i> Create Flat
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null) 
    { 
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div> 
    }

    @if (TempData["Error"] != null) 
    { 
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div> 
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Flat Number</th>
                        <th>Floor</th>
                        <th>Monthly Rent</th>
                        <th>Occupancy Status</th>
                        <th>Created</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var flat in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-primary">Flat @flat.FlatNumber</td>
                        <td>Floor @flat.FloorNumber</td>
                        <td>
                            <strong class="text-dark">৳@flat.MonthlyRent.ToString("N0")</strong>
                            <small class="text-muted d-block">/month (Tenants)</small>
                        </td>
                        <td>
                            <span class="badge @(flat.FlatStatus == "Occupied" ? "bg-warning text-dark" : "bg-success")">
                                @flat.FlatStatus
                            </span>
                        </td>
                        <td>@flat.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end pe-4">
                            <a asp-action="EditFlat" asp-route-id="@flat.FlatId" class="btn btn-sm btn-outline-secondary rounded-3">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Rent
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) 
                { 
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="fa-solid fa-building fs-3 d-block mb-2 text-secondary opacity-50"></i>
                            No flats have been created yet. Click "Create Flat" to add one.
                        </td>
                    </tr> 
                }
                </tbody>
            </table>
        </div>
    </div>
</div>