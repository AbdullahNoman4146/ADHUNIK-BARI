@model ADHUNIK_BARI.ViewModels.CreateFlatViewModel
@{ ViewData["Title"] = "Create Flat"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-md-7">
    <div class="card shadow-sm border-0"><div class="card-body p-4"><h1 class="h3 mb-4">Create Flat</h1>
        <form asp-action="CreateFlat" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="FlatNumber" class="form-label">Flat Number</label><input asp-for="FlatNumber" class="form-control" /><span asp-validation-for="FlatNumber" class="text-danger"></span></div>
            <div class="mb-4"><label asp-for="FloorNumber" class="form-label">Floor Number</label><input asp-for="FloorNumber" class="form-control" type="number" min="0" /><span asp-validation-for="FloorNumber" class="text-danger"></span></div>
            <a asp-action="Flats" class="btn btn-outline-secondary">Cancel</a> <button type="submit" class="btn btn-primary">Create Flat</button>
        </form>
    </div></div>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }