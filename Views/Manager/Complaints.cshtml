@model ADHUNIK_BARI.ViewModels.ManagerComplaintListViewModel
@{ ViewData["Title"] = "Service requests"; var total = Model.Complaints.Count(); var pending = Model.Complaints.Count(c => c.ComplaintStatus == "Pending"); var active = Model.Complaints.Count(c => c.ComplaintStatus == "In Progress"); }
<div class="ab-app-page">
    <header class="ab-page-heading ab-page-heading-compact"><div><div class="ab-page-kicker"><span></span>Resident care</div><h1>Service request <em>center.</em></h1><p>Triage, track, and resolve resident concerns with a clear operational queue.</p></div><div class="ab-page-heading-actions"><a asp-action="ComplaintAISummary" class="ab-app-btn ab-app-btn-primary"><i class="fa-solid fa-wand-magic-sparkles"></i>AI operations brief</a></div></header>
    <section class="ab-stat-strip"><article class="ab-stat-chip"><span><i class="fa-solid fa-inbox"></i></span><div><strong>@total</strong><small>Matching requests</small></div></article><article class="ab-stat-chip"><span><i class="fa-solid fa-clock"></i></span><div><strong>@pending</strong><small>Waiting review</small></div></article><article class="ab-stat-chip"><span><i class="fa-solid fa-person-digging"></i></span><div><strong>@active</strong><small>In progress</small></div></article></section>
    <section class="ab-panel ab-filter-panel"><form asp-action="Complaints" method="get" class="ab-filter-row"><div><label asp-for="FlatNumber" class="form-label">Search flat</label><input asp-for="FlatNumber" class="form-control" placeholder="e.g. A-101" /></div><div><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option value="">All statuses</option><option>Pending</option><option>In Progress</option><option>Solved</option></select></div><button type="submit" class="ab-app-btn ab-app-btn-primary"><i class="fa-solid fa-magnifying-glass"></i>Filter queue</button></form></section>
    <section class="ab-panel ab-data-panel"><div class="ab-panel-head"><div class="ab-table-title"><span><i class="fa-solid fa-screwdriver-wrench"></i></span><div><div class="ab-panel-kicker">REQUEST QUEUE</div><h2>Resident issues</h2></div></div><div class="ab-panel-status"><i></i>Live</div></div>
        @if (Model.Complaints.Any()) { <div class="table-responsive"><table class="table ab-app-table align-middle"><thead><tr><th>Flat</th><th>Resident</th><th>Category</th><th>Status</th><th>Created</th><th class="text-end">Action</th></tr></thead><tbody>
        @foreach (var complaint in Model.Complaints) { var statusClass = complaint.ComplaintStatus switch { "Solved" => "ab-status-success", "In Progress" => "ab-status-info", _ => "ab-status-warning" }; <tr><td><span class="ab-unit-pill">@(complaint.Flat?.FlatNumber ?? "—")</span></td><td>@(complaint.User?.FullName ?? complaint.User?.Email ?? "Unknown")</td><td>@complaint.Category</td><td><span class="ab-status @statusClass"><i></i>@complaint.ComplaintStatus</span></td><td>@complaint.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td><td class="text-end"><a asp-action="ComplaintDetails" asp-route-id="@complaint.ComplaintId" class="ab-app-btn ab-app-btn-secondary ab-app-btn-small">Open request<i class="fa-solid fa-arrow-right"></i></a></td></tr> }
        </tbody></table></div> } else { <div class="ab-empty-state-app"><i class="fa-solid fa-circle-check"></i><h2>No requests match this view</h2><p>Adjust your filters or enjoy the clear queue.</p></div> }
    </section>
</div>
