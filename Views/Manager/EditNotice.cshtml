@model ADHUNIK_BARI.ViewModels.NoticeViewModel
@{ ViewData["Title"] = "Edit notice"; }
<div class="ab-app-page"><header class="ab-page-heading ab-page-heading-compact"><div><div class="ab-page-kicker"><span></span>Update communication</div><h1>Refine the <em>notice.</em></h1><p>Adjust the message or audience while preserving a clear resident experience.</p></div></header>
<section class="ab-panel ab-form-shell"><aside class="ab-form-aside"><i class="fa-solid fa-pen-to-square"></i><small>Published content</small><h2>Keep every update accurate.</h2><p>Review the audience before saving so private apartment updates stay appropriately targeted.</p></aside>
<form asp-action="EditNotice" method="post" class="ab-form-body"><input asp-for="NoticeId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="ab-field-grid">
<div class="ab-field-span-2"><label asp-for="Title" class="form-label">Notice title</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger small"></span></div>
<div class="ab-field-span-2"><label asp-for="Description" class="form-label">Message</label><textarea asp-for="Description" class="form-control" rows="6"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
<div class="ab-field-span-2"><label asp-for="NoticeType" class="form-label">Audience</label><select asp-for="NoticeType" class="form-select" data-notice-type><option value="General">Everyone</option><option value="SpecificFlats">Selected flats</option></select></div>
<div class="ab-field-span-2" data-notice-targets><label class="form-label">Select apartments</label><div class="row g-2">@foreach (var flat in Model.Flats) { var selected = Model.TargetFlatIds.Contains(flat.FlatId); <div class="col-sm-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="TargetFlatIds" value="@flat.FlatId" id="flat-@flat.FlatId" checked="@(selected ? "checked" : null)" /><label class="form-check-label" for="flat-@flat.FlatId">Flat @flat.FlatNumber · Floor @flat.FloorNumber</label></div></div> }</div><span asp-validation-for="TargetFlatIds" class="text-danger small"></span></div>
</div><div class="ab-form-actions"><a asp-action="Notices" class="ab-app-btn ab-app-btn-secondary">Cancel</a><button type="submit" class="ab-app-btn ab-app-btn-primary"><i class="fa-solid fa-check"></i>Save changes</button></div></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
