@model ADHUNIK_BARI.ViewModels.ManagerGymDashboardViewModel
@{
    ViewData["Title"] = "Gym Management";
}

<div class="container-fluid px-4 py-4 fade-in">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Gym Management & Memberships</h1>
            <p class="text-muted mb-0">Control facility settings, manage resident applications, and track active member passes.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Manager" asp-action="Bills" class="btn btn-outline-secondary rounded-3">
                <i class="fa-solid fa-wallet me-1"></i> Billing Center
            </a>
            <a asp-controller="Manager" asp-action="Dashboard" class="btn btn-outline-dark rounded-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Active Members</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalActiveMembers</h3>
                        <small class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>Currently enrolled</small>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-4 fs-4">
                        <i class="fa-solid fa-id-card-clip"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Pending Requests</span>
                        <h3 class="fw-bold mb-0 text-warning">@Model.TotalPendingRequests</h3>
                        <small class="text-muted">Applications & renewals</small>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-4 fs-4">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-4 col-sm-12">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Expiring in 7 Days</span>
                        <h3 class="fw-bold mb-0 @(Model.TotalExpiringSoon > 0 ? "text-danger" : "text-dark")">@Model.TotalExpiringSoon</h3>
                        <small class="text-muted">Requires renewal review</small>
                    </div>
                    <div class="p-3 bg-danger-subtle text-danger rounded-4 fs-4">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
        <div class="card-header bg-white border-bottom p-3">
            <ul class="nav nav-pills card-header-pills gap-2" id="gymTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-3 px-3 py-2 fw-semibold" id="pending-tab" data-bs-toggle="pill" data-bs-target="#pendingPane" type="button" role="tab">
                        <i class="fa-solid fa-user-clock me-1"></i> Pending Requests
                        @if (Model.TotalPendingRequests > 0)
                        {
                            <span class="badge bg-warning text-dark ms-1">@Model.TotalPendingRequests</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-3 px-3 py-2 fw-semibold" id="active-tab" data-bs-toggle="pill" data-bs-target="#activePane" type="button" role="tab">
                        <i class="fa-solid fa-circle-check me-1"></i> Active Members
                        <span class="badge bg-success-subtle text-success ms-1">@Model.TotalActiveMembers</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-3 px-3 py-2 fw-semibold" id="history-tab" data-bs-toggle="pill" data-bs-target="#historyPane" type="button" role="tab">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i> Expired & Cancelled
                        <span class="badge bg-light text-dark border ms-1">@Model.ExpiredOrCancelledMembers.Count</span>
                    </button>
                </li>
                <li class="nav-item ms-auto" role="presentation">
                    <button class="nav-link rounded-3 px-3 py-2 fw-semibold" id="settings-tab" data-bs-toggle="pill" data-bs-target="#settingsPane" type="button" role="tab">
                        <i class="fa-solid fa-gear me-1"></i> Facility Settings & Rules
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="gymTabsContent">
            <!-- TAB 1: PENDING REQUESTS -->
            <div class="tab-pane fade show active p-4" id="pendingPane" role="tabpanel">
                @if (Model.PendingRequests.Count == 0)
                {
                    <div class="text-center py-5">
                        <div class="p-3 bg-light rounded-circle d-inline-flex text-success mb-3 fs-3">
                            <i class="fa-solid fa-clipboard-check"></i>
                        </div>
                        <h5 class="fw-bold">No Pending Requests</h5>
                        <p class="text-muted mb-0">All gym applications and renewal requests have been reviewed.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Pass Holder & Resident</th>
                                    <th>Flat / Allocation</th>
                                    <th>Request Type</th>
                                    <th>Requested On</th>
                                    <th>Notes</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PendingRequests)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrWhiteSpace(item.MemberPhotoUrl))
                                                {
                                                    <img src="@item.MemberPhotoUrl" alt="@item.MemberName" class="rounded-circle object-fit-cover border shadow-xs" style="width: 38px; height: 38px; min-width: 38px;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle bg-warning-subtle text-warning fw-bold d-flex align-items-center justify-content-center border" style="width: 38px; height: 38px; min-width: 38px; font-size: 0.85rem;">
                                                        @(string.IsNullOrWhiteSpace(item.MemberName) ? "M" : item.MemberName.Substring(0, 1).ToUpper())
                                                    </div>
                                                }
                                                <div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="fw-bold text-dark">@item.MemberName</span>
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill py-0 px-2 small">@item.MemberRelation</span>
                                                    </div>
                                                    <div class="small text-muted">
                                                        Res: @item.ResidentName
                                                        @if (!string.IsNullOrWhiteSpace(item.MemberGender) || item.MemberAge.HasValue)
                                                        {
                                                            <span> &bull; @item.MemberGender @(item.MemberAge.HasValue ? $"{item.MemberAge} yrs" : "")</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.MemberPhone))
                                                        {
                                                            <span> &bull; @item.MemberPhone</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                <i class="fa-solid fa-door-closed me-1 text-primary"></i>Flat @item.FlatNumber
                                            </span>
                                            <small class="text-muted d-block mt-1">@item.ResidentType</small>
                                        </td>
                                        <td>
                                            @if (item.RenewalStatus == "RenewalPending")
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                    <i class="fa-solid fa-arrows-rotate me-1"></i> Renewal (@item.PackageName)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                    <i class="fa-solid fa-layer-group me-1"></i> @item.PackageName (৳@item.PaySlipAmount.ToString("N0"))
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-dark">@item.RequestedAt.ToString("MMM dd, yyyy")</div>
                                            <small class="text-muted">@item.RequestedAt.ToString("hh:mm tt")</small>
                                        </td>
                                        <td>
                                            <small class="text-muted">@(string.IsNullOrWhiteSpace(item.Notes) ? "None provided" : item.Notes)</small>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <button type="button" class="btn btn-sm btn-success rounded-3 approve-gym-btn"
                                                        data-bs-toggle="modal" data-bs-target="#approveModal"
                                                        data-id="@item.GymMembershipId"
                                                        data-member="@item.MemberName"
                                                        data-applicant="@item.ResidentName"
                                                        data-fee="@(item.PaySlipAmount > 0 ? item.PaySlipAmount : item.MonthlyFee)"
                                                        data-months="@item.DurationMonths"
                                                        data-package="@item.PackageName">
                                                    <i class="fa-solid fa-check me-1"></i> Approve
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-3 reject-gym-btn"
                                                        data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                        data-id="@item.GymMembershipId"
                                                        data-name="@item.MemberName">
                                                    <i class="fa-solid fa-xmark me-1"></i> Reject
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (Model.PendingPaymentSlips.Count > 0)
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i>Approved &mdash; Awaiting Resident Payment
                                </h6>
                                <small class="text-muted">Applications approved by management with fee slip issued. Membership automatically activates upon payment.</small>
                            </div>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">
                                @Model.PendingPaymentSlips.Count Pending Payment
                            </span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Pass Holder & Member</th>
                                        <th>Flat</th>
                                        <th>Pay Slip</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slip in Model.PendingPaymentSlips)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrWhiteSpace(slip.MemberPhotoUrl))
                                                    {
                                                        <img src="@slip.MemberPhotoUrl" alt="@slip.MemberName" class="rounded-circle object-fit-cover border shadow-xs" style="width: 38px; height: 38px; min-width: 38px;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle bg-warning-subtle text-warning fw-bold d-flex align-items-center justify-content-center border" style="width: 38px; height: 38px; min-width: 38px; font-size: 0.85rem;">
                                                            @(string.IsNullOrWhiteSpace(slip.MemberName) ? "M" : slip.MemberName.Substring(0, 1).ToUpper())
                                                        </div>
                                                    }
                                                    <div>
                                                        <span class="fw-bold text-dark">@slip.MemberName</span>
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill py-0 px-2 small">@slip.MemberRelation</span>
                                                        <div class="small text-muted">Res: @slip.ResidentName</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1">
                                                    <i class="fa-solid fa-door-closed me-1 text-primary"></i>Flat @slip.FlatNumber
                                                </span>
                                            </td>
                                            <td>
                                                <div class="font-monospace fw-semibold text-secondary small">#@slip.FormattedPaySlipNumber</div>
                                                <strong class="text-success">৳@slip.PaySlipAmount.ToString("N0")</strong>
                                                <span class="badge bg-light text-muted border py-0 px-2 small ms-1">@slip.PackageName</span>
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Gym" asp-action="PaySlip" asp-route-id="@slip.GymMembershipId" class="btn btn-sm btn-outline-primary rounded-3 text-nowrap">
                                                    <i class="fa-solid fa-file-invoice me-1"></i> View Slip
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <!-- TAB 2: ACTIVE MEMBERS -->
            <div class="tab-pane fade p-4" id="activePane" role="tabpanel">
                @if (Model.ActiveMembers.Count == 0)
                {
                    <div class="text-center py-5">
                        <div class="p-3 bg-light rounded-circle d-inline-flex text-muted mb-3 fs-3">
                            <i class="fa-solid fa-dumbbell"></i>
                        </div>
                        <h5 class="fw-bold">No Active Gym Members Yet</h5>
                        <p class="text-muted mb-0">Members will automatically appear here once their ৳500 fee slip is paid.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Pass Holder & Member</th>
                                    <th>Flat</th>
                                    <th>Duration / Validity</th>
                                    <th>Days Remaining</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model.ActiveMembers)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrWhiteSpace(member.MemberPhotoUrl))
                                                {
                                                    <img src="@member.MemberPhotoUrl" alt="@member.MemberName" class="rounded-circle object-fit-cover border shadow-xs" style="width: 38px; height: 38px; min-width: 38px;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center border" style="width: 38px; height: 38px; min-width: 38px; font-size: 0.85rem;">
                                                        @(string.IsNullOrWhiteSpace(member.MemberName) ? "M" : member.MemberName.Substring(0, 1).ToUpper())
                                                    </div>
                                                }
                                                <div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="fw-bold text-dark">@member.MemberName</span>
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill py-0 px-2 small">@member.MemberRelation</span>
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill py-0 px-2 small">@member.PackageName</span>
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle py-0 px-2 small">
                                                            <i class="fa-solid fa-circle-check me-1"></i>Active & Paid
                                                        </span>
                                                        @if (member.CancellationRequestedAt.HasValue)
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-0 px-2 small">
                                                                <i class="fa-solid fa-ban me-1"></i>Ends @member.CancellationEffectiveDate?.ToString("MMM dd")
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="small text-muted d-flex align-items-center gap-2">
                                                        <span>Res: @member.ResidentName</span>
                                                        <span>&bull;</span>
                                                        <span class="font-monospace text-secondary fw-semibold">@member.FormattedCardNumber</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                <i class="fa-solid fa-door-closed me-1 text-primary"></i>Flat @member.FlatNumber
                                            </span>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-dark">@(member.StartDate?.ToString("MMM dd, yyyy") ?? "N/A") &mdash; @(member.ExpiryDate?.ToString("MMM dd, yyyy") ?? "Open")</div>
                                        </td>
                                        <td>
                                            @if (member.DaysRemaining <= 7)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                    <i class="fa-solid fa-hourglass-half me-1"></i> @member.DaysRemaining days left
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="fa-solid fa-circle-check me-1"></i> @member.DaysRemaining days
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex align-items-center gap-2">
                                                <a asp-controller="Manager" asp-action="GymIdCard" asp-route-id="@member.GymMembershipId" class="btn btn-sm btn-outline-primary rounded-3 text-nowrap fw-semibold">
                                                    <i class="fa-solid fa-id-card me-1"></i> ID Card
                                                </a>

                                                <div class="dropdown d-inline-block">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        Manage
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                                        <li>
                                                            <a asp-controller="Gym" asp-action="PaySlip" asp-route-id="@member.GymMembershipId" class="dropdown-item">
                                                                <i class="fa-solid fa-file-invoice text-info me-2"></i> View Pay Slip
                                                            </a>
                                                        </li>

                                                        <li>
                                                            <a asp-controller="Manager" asp-action="GymIdCard" asp-route-id="@member.GymMembershipId" class="dropdown-item">
                                                                <i class="fa-solid fa-id-card me-2 text-primary"></i> View / Print Pass
                                                            </a>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form asp-controller="Manager" asp-action="RenewGymMembership" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@member.GymMembershipId" />
                                                                <input type="hidden" name="durationMonths" value="1" />
                                                                <button type="submit" class="dropdown-item">
                                                                    <i class="fa-solid fa-arrows-rotate me-2 text-success"></i> Extend 1 Month
                                                                </button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form asp-controller="Manager" asp-action="RenewGymMembership" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@member.GymMembershipId" />
                                                                <input type="hidden" name="durationMonths" value="3" />
                                                                <button type="submit" class="dropdown-item">
                                                                    <i class="fa-solid fa-arrows-rotate me-2 text-primary"></i> Extend 3 Months
                                                                </button>
                                                            </form>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <button type="button" class="dropdown-item text-danger cancel-gym-btn" 
                                                                    data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                                    data-id="@member.GymMembershipId"
                                                                    data-name="@member.ResidentName">
                                                                <i class="fa-solid fa-ban me-2"></i> Cancel Membership
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- TAB 3: EXPIRED & CANCELLED -->
            <div class="tab-pane fade p-4" id="historyPane" role="tabpanel">
                @if (Model.ExpiredOrCancelledMembers.Count == 0)
                {
                    <div class="text-center py-5">
                        <div class="p-3 bg-light rounded-circle d-inline-flex text-muted mb-3 fs-3">
                            <i class="fa-solid fa-box-archive"></i>
                        </div>
                        <h5 class="fw-bold">No Past Memberships</h5>
                        <p class="text-muted mb-0">Expired, rejected, or cancelled memberships will be archived here.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Resident</th>
                                    <th>Flat</th>
                                    <th>Status</th>
                                    <th>End / Expiry Date</th>
                                    <th>Notes / Reason</th>
                                    <th class="text-end">Reactivation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ExpiredOrCancelledMembers)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@item.ResidentName</div>
                                            <small class="text-muted">@item.Email | @item.Phone</small>
                                        </td>
                                        <td>Flat @item.FlatNumber</td>
                                        <td>
                                            @if (item.Status == "Expired")
                                            {
                                                <span class="badge bg-secondary">Expired</span>
                                            }
                                            else if (item.Status == "Cancelled")
                                            {
                                                <span class="badge bg-dark">Cancelled</span>
                                            }
                                            else if (item.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">@item.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.ExpiryDate.HasValue)
                                            {
                                                <div>@item.ExpiryDate.Value.ToString("MMM dd, yyyy")</div>
                                            }
                                            else if (item.CancellationEffectiveDate.HasValue)
                                            {
                                                <div>@item.CancellationEffectiveDate.Value.ToString("MMM dd, yyyy")</div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @(item.RejectionReason ?? item.CancellationReason ?? item.Notes ?? "No notes")
                                            </small>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-3 approve-gym-btn"
                                                    data-bs-toggle="modal" data-bs-target="#approveModal"
                                                    data-id="@item.GymMembershipId"
                                                    data-name="@item.ResidentName"
                                                    data-fee="@(item.MonthlyFee > 0 ? item.MonthlyFee : Model.GymSettings.MonthlyFee)">
                                                <i class="fa-solid fa-power-off me-1"></i> Reactivate
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- TAB 4: FACILITY SETTINGS -->
            <div class="tab-pane fade p-4" id="settingsPane" role="tabpanel">
                <div class="row">
                    <div class="col-lg-8">
                        <form asp-controller="Manager" asp-action="UpdateGymSettings" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="GymSettings.GymSettingId" />

                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label asp-for="GymSettings.GymName" class="form-label fw-bold small text-muted text-uppercase"></label>
                                    <input asp-for="GymSettings.GymName" class="form-control rounded-3" placeholder="e.g. Adhunik Bari Fitness Club" required />
                                    <span asp-validation-for="GymSettings.GymName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-5">
                                    <label asp-for="GymSettings.MonthlyFee" class="form-label fw-bold small text-muted text-uppercase"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light fw-bold">৳</span>
                                        <input asp-for="GymSettings.MonthlyFee" class="form-control rounded-end-3" type="number" step="10" min="0" required />
                                    </div>
                                    <span asp-validation-for="GymSettings.MonthlyFee" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="GymSettings.OpeningHours" class="form-label fw-bold small text-muted text-uppercase"></label>
                                    <input asp-for="GymSettings.OpeningHours" class="form-control rounded-3" placeholder="e.g. 6:00 AM - 10:00 PM (Daily)" required />
                                    <span asp-validation-for="GymSettings.OpeningHours" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="GymSettings.Location" class="form-label fw-bold small text-muted text-uppercase"></label>
                                    <input asp-for="GymSettings.Location" class="form-control rounded-3" placeholder="e.g. 2nd Floor Amenities Area" />
                                    <span asp-validation-for="GymSettings.Location" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="GymSettings.ContactPhone" class="form-label fw-bold small text-muted text-uppercase"></label>
                                    <input asp-for="GymSettings.ContactPhone" class="form-control rounded-3" placeholder="e.g. +880 1712-345678" />
                                    <span asp-validation-for="GymSettings.ContactPhone" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 d-flex align-items-center mt-4">
                                    <div class="form-check form-switch fs-5">
                                        <input asp-for="GymSettings.IsActive" class="form-check-input" type="checkbox" role="switch" id="gymActiveSwitch">
                                        <label class="form-check-label fs-6 fw-semibold ms-2" for="gymActiveSwitch">Gym Facility Open for Residents</label>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label asp-for="GymSettings.EquipmentInformation" class="form-label fw-bold small text-muted text-uppercase"></label>
                                    <textarea asp-for="GymSettings.EquipmentInformation" class="form-control rounded-3" rows="3" placeholder="List available machines, free weights, benches, and accessories..."></textarea>
                                    <small class="text-muted">Residents can view this list to see what equipment is provided.</small>
                                </div>

                                <div class="col-12">
                                    <label asp-for="GymSettings.RulesAndGuidelines" class="form-label fw-bold small text-muted text-uppercase"></label>
                                    <textarea asp-for="GymSettings.RulesAndGuidelines" class="form-control rounded-3" rows="4" placeholder="Enter building gym rules, footwear requirements, hygiene policies..."></textarea>
                                    <small class="text-muted">Residents must agree to these rules upon applying.</small>
                                </div>

                                <div class="col-12 pt-2">
                                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-bold shadow-sm">
                                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Gym Settings
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-lg-4 mt-4 mt-lg-0">
                        <div class="card border rounded-4 p-4 bg-light">
                            <h5 class="fw-bold mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i>Gym Management Guide</h5>
                            <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-3">
                                <li>
                                    <strong class="text-dark d-block mb-1">1. Multi-Member Enrolment & Photos</strong>
                                    Residents can apply for gym passes for themselves or their family members, complete with photo capture for official ID cards.
                                </li>
                                <li>
                                    <strong class="text-dark d-block mb-1">2. Approval & ৳500 Pay Slip</strong>
                                    When management approves an application, an official ৳500 Gym Fee Pay Slip is issued to the resident.
                                </li>
                                <li>
                                    <strong class="text-dark d-block mb-1">3. Stripe Payment & Automatic Activation</strong>
                                    Residents pay the ৳500 fee slip online via Stripe. Once paid, the system automatically activates their membership and issues their official scannable QR Member ID Card.
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- APPROVAL MODAL -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom p-4">
                <h5 class="modal-title fw-bold" id="approveModalLabel">
                    <i class="fa-solid fa-circle-check text-success me-2"></i>Approve Gym Membership Pass
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Manager" asp-action="ApproveGymMembership" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="GymMembershipId" id="approveMembershipId" />
                <div class="modal-body p-4">
                    <div class="alert alert-light border rounded-3 mb-3">
                        <small class="text-muted d-block">Pass Holder (Member):</small>
                        <strong class="fs-6 text-dark d-block" id="approveMemberName">Member Name</strong>
                        <div class="small text-muted mt-1">
                            Applicant: <span id="approveApplicantName">Resident Name</span> &bull; 
                            Requested Package: <span id="approvePackageBadge" class="badge bg-primary-subtle text-primary">1 Month Pass</span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Start Date</label>
                            <input type="date" name="StartDate" id="approveStartDate" class="form-control rounded-3" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Expiry Date</label>
                            <input type="date" name="ExpiryDate" id="approveExpiryDate" class="form-control rounded-3" value="@DateTime.UtcNow.AddMonths(1).ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Package Fee Amount (৳)</label>
                            <input type="number" step="10" min="0" name="TotalFeeAmount" id="approveTotalFee" class="form-control rounded-3" value="@Model.GymSettings.MonthlyFee" required />
                            <small class="text-muted">A dedicated Gym Fee Pay Slip will be generated with this amount. Resident pays via Stripe to activate membership and ID card.</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Notes / Instructions (Optional)</label>
                            <input type="text" name="PaySlipNotes" id="approveNotes" class="form-control rounded-3" placeholder="e.g. Standard gym pass" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer p-3 border-top bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-3 fw-bold px-4">
                        <i class="fa-solid fa-file-invoice me-1"></i> Approve & Issue Pay Slip
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- REJECTION MODAL -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom p-4">
                <h5 class="modal-title fw-bold text-danger" id="rejectModalLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Reject Membership Application
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Manager" asp-action="RejectGymMembership" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="GymMembershipId" id="rejectMembershipId" />
                <div class="modal-body p-4">
                    <p class="text-muted mb-3">Rejecting application for <strong id="rejectApplicantName" class="text-dark">Resident</strong>. Please specify the reason below:</p>
                    <label class="form-label fw-semibold small">Rejection Reason</label>
                    <textarea name="RejectionReason" class="form-control rounded-3" rows="3" placeholder="e.g. Incomplete resident profile, facility at maximum capacity, or unpaid building dues..." required></textarea>
                </div>
                <div class="modal-footer p-3 border-top bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger rounded-3 fw-bold px-4">
                        <i class="fa-solid fa-ban me-1"></i> Reject Application
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CANCELLATION MODAL -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom p-4">
                <h5 class="modal-title fw-bold text-danger" id="cancelModalLabel">
                    <i class="fa-solid fa-ban me-2"></i>Cancel Membership
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Manager" asp-action="CancelGymMembership" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="cancelMembershipId" />
                <div class="modal-body p-4">
                    <p class="text-muted mb-3">Are you sure you want to cancel the membership for <strong id="cancelApplicantName" class="text-dark">Resident</strong>? Future monthly gym fees will cease immediately.</p>
                    <label class="form-label fw-semibold small">Cancellation Note (Optional)</label>
                    <input type="text" name="reason" class="form-control rounded-3" placeholder="e.g. Resident requested cancellation / Moving out" />
                </div>
                <div class="modal-footer p-3 border-top bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger rounded-3 fw-bold px-4">
                        <i class="fa-solid fa-ban me-1"></i> Confirm Cancellation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Approve modal prep
            document.querySelectorAll('.approve-gym-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const member = this.getAttribute('data-member') || this.getAttribute('data-applicant');
                    const applicant = this.getAttribute('data-applicant') || '';
                    const fee = this.getAttribute('data-fee');
                    const months = parseInt(this.getAttribute('data-months') || '1', 10);
                    const pkg = this.getAttribute('data-package') || (months + ' Month Pass');

                    document.getElementById('approveMembershipId').value = id;
                    document.getElementById('approveMemberName').textContent = member;
                    document.getElementById('approveApplicantName').textContent = applicant;
                    
                    const pkgBadge = document.getElementById('approvePackageBadge');
                    if (pkgBadge) pkgBadge.textContent = pkg;

                    if (fee) {
                        document.getElementById('approveTotalFee').value = fee;
                    }

                    const notesInput = document.getElementById('approveNotes');
                    if (notesInput) notesInput.value = pkg + ' (Fee: ৳' + fee + ')';

                    const startDateInput = document.getElementById('approveStartDate');
                    const expiryDateInput = document.getElementById('approveExpiryDate');
                    const now = new Date();
                    startDateInput.value = now.toISOString().split('T')[0];

                    const expiry = new Date();
                    expiry.setMonth(expiry.getMonth() + months);
                    expiryDateInput.value = expiry.toISOString().split('T')[0];
                });
            });

            // Reject modal prep
            document.querySelectorAll('.reject-gym-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('rejectMembershipId').value = this.getAttribute('data-id');
                    document.getElementById('rejectApplicantName').textContent = this.getAttribute('data-name');
                });
            });

            // Cancel modal prep
            document.querySelectorAll('.cancel-gym-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('cancelMembershipId').value = this.getAttribute('data-id');
                    document.getElementById('cancelApplicantName').textContent = this.getAttribute('data-name');
                });
            });
        });
    </script>
}
