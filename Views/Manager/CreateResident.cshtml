@model ADHUNIK_BARI.ViewModels.CreateResidentViewModel
@{ ViewData["Title"] = "Create resident"; }
<div class="ab-app-page">
    <header class="ab-page-heading ab-page-heading-compact"><div><div class="ab-page-kicker"><span></span>Resident accounts</div><h1>Welcome a new <em>resident.</em></h1><p>Create secure portal access before assigning an apartment.</p></div></header>
    <section class="ab-panel ab-form-shell">
        <aside class="ab-form-aside"><i class="fa-solid fa-user-shield"></i><small>Account onboarding</small><h2>A considered first impression.</h2><p>Residents use this account for bills, notices, service requests, and receipts. Provide an email they can access.</p></aside>
        <form asp-action="CreateResident" method="post" class="ab-form-body"><div asp-validation-summary="All" class="text-danger mb-3"></div><div class="ab-field-grid">
            <div><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Resident's full name" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
            <div><label asp-for="Phone" class="form-label">Phone</label><input asp-for="Phone" class="form-control" autocomplete="tel" inputmode="tel" placeholder="01XXXXXXXXX" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
            <div class="ab-field-span-2"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="resident@example.com" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div><label asp-for="ResidentType" class="form-label">Resident type</label><select asp-for="ResidentType" class="form-select"><option value="">Choose type</option><option value="Tenant">Tenant</option><option value="FlatOwner">Flat owner</option></select><span asp-validation-for="ResidentType" class="text-danger small"></span></div>
            <div><label asp-for="TemporaryPassword" class="form-label">Temporary password</label><input asp-for="TemporaryPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="TemporaryPassword" class="text-danger small"></span></div>
            <div class="ab-field-span-2 ab-field-note"><i class="fa-solid fa-lock"></i><span>The resident will be prompted to replace the temporary password after signing in.</span></div>
        </div><div class="ab-form-actions"><a asp-action="Dashboard" class="ab-app-btn ab-app-btn-secondary">Cancel</a><button type="submit" class="ab-app-btn ab-app-btn-primary"><i class="fa-solid fa-user-plus"></i>Create account</button></div></form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
