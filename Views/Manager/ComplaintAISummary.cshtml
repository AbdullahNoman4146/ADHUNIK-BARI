@model ADHUNIK_BARI.ViewModels.ComplaintAISummaryViewModel

@{ ViewData["Title"] = "AI service brief"; }
<div class="ab-app-page">
    <header class="ab-page-heading ab-page-heading-compact">
        <div><div class="ab-page-kicker"><span></span>Operational intelligence</div><h1>AI service <em>brief.</em></h1><p>Turn resident request patterns into clear property-management priorities.</p></div>
        <a asp-action="Complaints" class="ab-app-btn ab-app-btn-secondary"><i class="fa-solid fa-arrow-left"></i>Back to requests</a>
    </header>



    <!-- Selection Card -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">


            <form method="post">


                <label class="fw-semibold mb-2">
                    Analyze complaints from
                </label>


                <select name="months"
                        class="form-select mb-3">


                    <option value="1">
                        Last 1 Month
                    </option>


                    <option value="2">
                        Last 2 Months
                    </option>


                    <option value="3">
                        Last 3 Months
                    </option>


                    <option value="6">
                        Last 6 Months
                    </option>


                    <option value="12">
                        Last 1 Year
                    </option>


                </select>



                <button class="btn btn-primary w-100 py-2">

                    <i class="fa-solid fa-robot me-2"></i>

                    Generate AI Analysis

                </button>


            </form>


        </div>

    </div>





    @if (Model != null && Model.Report != null)
    {


        <!-- Overview Cards -->

        <div class="row mb-4">


            <div class="col-md-4 mb-3">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body">


                        <h6 class="text-muted">
                            Analysis Period
                        </h6>


                        <h3>
                            @Model.Months Months
                        </h3>


                        <small>
                            Complaint monitoring window
                        </small>


                    </div>

                </div>

            </div>




            <div class="col-md-4 mb-3">


                <div class="card shadow-sm border-0 h-100">


                    <div class="card-body">


                        <h6 class="text-muted">
                            Total Complaints
                        </h6>


                        <h3>
                            @Model.TotalComplaints
                        </h3>


                        <small>
                            Resident complaints analyzed
                        </small>


                    </div>


                </div>


            </div>





            <div class="col-md-4 mb-3">


                <div class="card shadow-sm border-0 h-100">


                    <div class="card-body">


                        <h6 class="text-muted">
                            Risk Level
                        </h6>



                        @if (Model.Report.RiskLevel == "HIGH")
                        {
                            <span class="badge bg-danger fs-6">
                                🔴 HIGH PRIORITY
                            </span>
                        }
                        else if (Model.Report.RiskLevel == "MEDIUM")
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                🟠 MEDIUM
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6">
                                🟢 LOW
                            </span>
                        }


                    </div>


                </div>


            </div>


        </div>






        <!-- AI Summary -->

        <div class="card shadow-sm border-0 mb-4">


            <div class="card-body">


                <h4>
                    🧠 AI Executive Summary
                </h4>


                <hr />


                <p class="fs-5">
                    @Model.Report.TotalSummary
                </p>


            </div>


        </div>







        <!-- Critical Issues -->

        <h4 class="mb-3">
            🚨 Critical Issues Detected
        </h4>



        <div class="row">


            @foreach (var item in Model.Report.CriticalIssues)
            {

                <div class="col-md-6 mb-4">


                    <div class="card shadow border-0 h-100">


                        <div class="card-body">


                            <h5 class="text-danger">
                                ⚠ @item.Title
                            </h5>



                            <p>
                                @item.Description
                            </p>



                            <span class="badge bg-danger mb-3">
                                @item.Severity
                            </span>



                            <div class="p-3 rounded bg-light">


                                <strong>
                                    Recommended Action
                                </strong>


                                <p class="mb-0">
                                    @item.Action
                                </p>


                            </div>



                        </div>


                    </div>


                </div>


            }


        </div>









        <!-- Common Problems -->


        <div class="card shadow-sm border-0 mb-4">


            <div class="card-body">


                <h4>
                    📊 Common Complaint Patterns
                </h4>


                <hr />


                @foreach (var problem in Model.Report.CommonProblems)
                {


                    <div class="d-flex justify-content-between mb-3">


                        <span>
                            @problem.Name
                        </span>


                        <span class="badge bg-primary">
                            @problem.Count complaints
                        </span>


                    </div>


                }


            </div>


        </div>









        <!-- Hidden Problems -->


        <div class="card shadow-sm border-warning mb-4">


            <div class="card-body">


                <h4 class="text-warning">
                    💡 Possible Hidden Problems
                </h4>


                <hr />


                <ul>


                    @foreach (var problem in Model.Report.HiddenProblems)
                    {

                        <li class="mb-2">
                            @problem
                        </li>

                    }


                </ul>


            </div>


        </div>








        <!-- Actions -->


        <div class="card shadow-sm border-success mb-4">


            <div class="card-body">


                <h4 class="text-success">
                    ✅ Recommended Management Actions
                </h4>


                <hr />


                <ol>


                    @foreach (var action in Model.Report.RecommendedActions)
                    {

                        <li class="mb-2">
                            @action
                        </li>

                    }


                </ol>


            </div>


        </div>



    }



    @if (ViewBag.Error != null)
    {

        <div class="alert alert-danger shadow-sm">

            <strong>
                AI Error:
            </strong>

            @ViewBag.Error

        </div>

    }


</div>
