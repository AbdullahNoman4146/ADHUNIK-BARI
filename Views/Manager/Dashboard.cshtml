@{
    ViewData["Title"] = "Manager Dashboard";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>

}

<div class="container mt-5">


    <h1>
        Welcome Manager
    </h1>


    <p>
        ADHUNIK BARI Management Dashboard
    </p>


    <div class="row mt-4">


        <div class="col-md-3">

            <a asp-controller="Manager"
               asp-action="CreateResident"
               style="text-decoration:none;color:black">


                <div class="card shadow p-3">


                    <h5>
                        Residents
                    </h5>


                    <p>
                        Create Tenant and Flat Owner accounts
                    </p>


                </div>


            </a>

        </div>



        <div class="col-md-3">
            <a asp-controller="Manager" asp-action="Notices" style="text-decoration:none;color:black">
                <div class="card shadow p-3">
                    <h5>Notices</h5>
                    <p>Publish resident announcements</p>
                </div>
            </a>
        </div>




        <div class="col-md-3">

            <a asp-controller="Manager" asp-action="Flats" style="text-decoration:none;color:black">
            <div class="card shadow p-3">

                <h5>
                    Flats
                </h5>

                <p>
                    Manage apartment flats
                </p>

            </div>
            </a>

        </div>




        <div class="col-md-3">

            <div class="card shadow p-3">

                <h5>
                    Bills
                </h5>

                <p>
                    Generate monthly bills
                </p>

            </div>

        </div>




        <div class="col-md-3">

            <div class="card shadow p-3">

                <h5>
                    Complaints
                </h5>

                <p>
                    Review complaints
                </p>

            </div>

        </div>


    </div>


</div>