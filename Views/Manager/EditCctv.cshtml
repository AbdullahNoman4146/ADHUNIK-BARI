@model ADHUNIK_BARI.Models.CctvCamera
@{
    ViewData["Title"] = $"Edit {Model.CameraName}";
}

@section Scripts {
    <script src="~/js/cctv-surveillance.js" asp-append-version="true"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<link rel="stylesheet" href="~/css/cctv-surveillance.css" asp-append-version="true" />

<div class="cctv-control-room">
    <header class="cctv-header">
        <div>
            <div class="cctv-kicker">
                <i class="fa-solid fa-pen text-success"></i>
                <span>DEVICE CONFIGURATION</span>
            </div>
            <h1 class="cctv-title">
                <i class="fa-solid fa-sliders text-success"></i> Edit @Model.CameraName
            </h1>
            <p class="cctv-subtitle">
                Update camera location, stream URL, or status.
            </p>
        </div>
        <div>
            <a class="ab-app-btn ab-app-btn-secondary" asp-action="Cctv">
                <i class="fa-solid fa-arrow-left"></i> Back to Surveillance
            </a>
        </div>
    </header>

    <div class="card p-4 rounded-3 shadow-sm mx-auto" style="max-width: 650px; background: #091612; border: 1px solid var(--cctv-border); color: #e2ede8;">
        <form asp-action="EditCctv" asp-route-id="@Model.CameraId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CameraId" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CameraName" class="form-label text-white small fw-bold"></label>
                <input asp-for="CameraName" class="form-control" style="background: #040907; border-color: var(--cctv-border); color: #fff;" required />
                <span asp-validation-for="CameraName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label text-white small fw-bold"></label>
                <input asp-for="Location" class="form-control" style="background: #040907; border-color: var(--cctv-border); color: #fff;" required />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="StreamUrl" class="form-label text-white small fw-bold mb-0"></label>
                    <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 small" data-test-url-btn>
                        <i class="fa-solid fa-play"></i> Test URL Preview
                    </button>
                </div>
                <input asp-for="StreamUrl" class="form-control" style="background: #040907; border-color: var(--cctv-border); color: #fff; font-family: monospace;" required />
                <small class="d-block mt-1 fw-medium" style="color: #a4c7b8; font-size: 0.825rem;">Direct stream URL (HTTP / MJPEG / MP4).</small>
                <span asp-validation-for="StreamUrl" class="text-danger small"></span>
            </div>

            <!-- Live URL Test Preview Box -->
            <div data-url-preview-status class="small mb-2"></div>
            <div class="cctv-modal-preview" data-url-preview-box>
                <img data-url-preview-media src="" alt="Live Stream Preview" />
            </div>

            <div class="mb-4 mt-3">
                <label asp-for="Status" class="form-label text-white small fw-bold"></label>
                <select asp-for="Status" class="form-select" style="background: #040907; border-color: var(--cctv-border); color: #fff;">
                    <option value="Online">Online</option>
                    <option value="Offline">Offline</option>
                </select>
            </div>

            <div class="d-flex align-items-center justify-content-between pt-2">
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="if(confirm('Are you sure you want to remove this camera?')) document.getElementById('deleteCameraForm').submit();">
                    <i class="fa-solid fa-trash"></i> Delete Camera
                </button>

                <div class="d-flex gap-2">
                    <a asp-action="Cctv" class="ab-app-btn ab-app-btn-secondary">Cancel</a>
                    <button type="submit" class="ab-app-btn ab-app-btn-primary">
                        <i class="fa-solid fa-check"></i> Save Changes
                    </button>
                </div>
            </div>
        </form>

        <form id="deleteCameraForm" asp-action="DeleteCctv" asp-route-id="@Model.CameraId" method="post" style="display: none;">
            @Html.AntiForgeryToken()
        </form>
    </div>
</div>
