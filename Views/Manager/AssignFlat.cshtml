@model ADHUNIK_BARI.ViewModels.AssignFlatViewModel
@{ ViewData["Title"] = "Assign Flat"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-md-7">
    <div class="card shadow-sm border-0"><div class="card-body p-4"><h1 class="h3 mb-4">Assign Resident to Flat</h1>
        <form asp-action="AssignFlat" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="FlatId" class="form-label">Available Flat</label><select asp-for="FlatId" class="form-select"><option value="">-- Select flat --</option>@foreach (var flat in Model.AvailableFlats) { <option value="@flat.FlatId">@flat.FlatNumber (Floor @flat.FloorNumber)</option> }</select><span asp-validation-for="FlatId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="UserId" class="form-label">Resident</label><select asp-for="UserId" class="form-select"><option value="">-- Select resident --</option>@foreach (var resident in Model.Residents) { <option value="@resident.Id">@resident.FullName (@resident.Email)</option> }</select><span asp-validation-for="UserId" class="text-danger"></span></div>
            <div class="mb-4"><label asp-for="ResidentType" class="form-label">Resident Type</label><select asp-for="ResidentType" class="form-select"><option value="">-- Select type --</option><option value="Tenant">Tenant</option><option value="FlatOwner">Flat Owner</option></select><span asp-validation-for="ResidentType" class="text-danger"></span></div>
            <a asp-action="Flats" class="btn btn-outline-secondary">Cancel</a> <button type="submit" class="btn btn-primary">Assign Flat</button>
        </form>
    </div></div>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }