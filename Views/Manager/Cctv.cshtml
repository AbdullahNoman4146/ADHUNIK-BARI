@model ADHUNIK_BARI.ViewModels.CctvDashboardViewModel
@{
    ViewData["Title"] = "CCTV Surveillance Station";
}

@section Scripts {
    <script src="~/js/cctv-surveillance.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/cctv-surveillance.css" asp-append-version="true" />

<div class="cctv-control-room">
    @Html.AntiForgeryToken()

    <div id="cctvToastContainer">
        @if (TempData["Success"] != null)
        {
            <div class="cctv-toast cctv-toast-success" data-auto-dismiss>
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-check text-success"></i>
                    <span>@TempData["Success"]</span>
                </div>
                <button type="button" class="cctv-toast-close" onclick="const t = this.closest('.cctv-toast'); t.classList.add('fading'); setTimeout(() => t.remove(), 500);" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="cctv-toast cctv-toast-danger" data-auto-dismiss>
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-triangle-exclamation text-danger"></i>
                    <span>@TempData["Error"]</span>
                </div>
                <button type="button" class="cctv-toast-close" onclick="const t = this.closest('.cctv-toast'); t.classList.add('fading'); setTimeout(() => t.remove(), 500);" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
    </div>

    <!-- Header & Action Bar -->
    <header class="cctv-header">
        <div>
            <h1 class="cctv-title m-0">
                <i class="fa-solid fa-video text-success"></i>
                CCTV Control Center
            </h1>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button" class="cctv-header-btn" data-cctv-refresh-all title="Refresh All Streams">
                <i class="fa-solid fa-arrows-rotate"></i>
                <span>Refresh All</span>
            </button>
            <button type="button" class="ab-app-btn ab-app-btn-primary" data-bs-toggle="modal" data-bs-target="#addCameraModal">
                <i class="fa-solid fa-plus"></i> Add Camera
            </button>
            <button type="button" class="cctv-header-btn" data-cctv-wall-fullscreen title="Fullscreen All Cameras">
                <i class="fa-solid fa-expand"></i>
                <span>Fullscreen All</span>
            </button>
        </div>
    </header>

    <!-- Telemetry Status Bar -->
    <div class="cctv-telemetry-bar">
        <div class="cctv-telemetry-items">
            <div class="cctv-telemetry-item">
                <span class="label">Total Feeds:</span>
                <span class="val text-white">@Model.TotalCameras</span>
            </div>
            <div class="cctv-telemetry-item">
                <span class="label">Online:</span>
                <span class="val text-success">@Model.OnlineCount</span>
            </div>
            <div class="cctv-telemetry-item">
                <span class="label">Offline:</span>
                <span class="val @(Model.OfflineCount > 0 ? "text-danger" : "text-muted")">@Model.OfflineCount</span>
            </div>
        </div>
    </div>

    <!-- Zone Filter Pills (if any zones exist) -->
    @if (Model.AvailableZones.Any())
    {
        <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
            <span class="small text-muted me-1">Zone:</span>
            <a asp-action="Cctv" asp-route-zone="All" class="badge text-decoration-none px-3 py-2 @(string.IsNullOrEmpty(Model.SelectedZone) || Model.SelectedZone == "All" ? "bg-success text-dark fw-bold" : "bg-dark text-white border border-secondary")">
                All Feeds (@Model.TotalCameras)
            </a>
            @foreach (var z in Model.AvailableZones)
            {
                <a asp-action="Cctv" asp-route-zone="@z" class="badge text-decoration-none px-3 py-2 @(Model.SelectedZone == z ? "bg-success text-dark fw-bold" : "bg-dark text-white border border-secondary")">
                    @z
                </a>
            }
        </div>
    }

    <!-- Surveillance Camera Grid or Empty State -->
    @if (Model.Cameras.Any())
    {
        <div class="cctv-matrix-container matrix-grid" data-cctv-matrix>
            @foreach (var cam in Model.Cameras)
            {
                <div class="cctv-card"
                     data-camera-id="@cam.CameraId"
                     data-cam-name="@cam.CameraName"
                     data-cam-location="@cam.Location">

                    <!-- Surveillance Video Screen -->
                    <div class="cctv-screen">
                        @if (cam.StreamUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) || cam.StreamUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase))
                        {
                            <video class="cctv-video-feed"
                                   src="@cam.StreamUrl"
                                   data-stream-src="@cam.StreamUrl"
                                   autoplay muted loop playsinline></video>
                        }
                        else
                        {
                            <img class="cctv-video-feed"
                                 src="@cam.StreamUrl"
                                 data-stream-src="@cam.StreamUrl"
                                 alt="@cam.CameraName"
                                 loading="lazy"
                                 onerror="this.onerror=null; this.parentElement.classList.add('stream-error');" />
                        }

                        <!-- CRT Scanlines & Vignette Shaders -->
                        <div class="cctv-scanlines"></div>
                        <div class="cctv-vignette"></div>
                        <div class="cctv-screen-shield"></div>

                        <!-- Monospace Security On-Screen Display (OSD) - TOP -->
                        <div class="cctv-osd-top">
                            <span class="cctv-osd-title">
                                <i class="fa-solid fa-crosshairs text-success"></i>
                                @cam.CameraName.ToUpperInvariant() · [@cam.Location.ToUpperInvariant()]
                            </span>
                            <span class="cctv-osd-timecode" data-osd-clock>
                                2026-09-04 00:00:00.000
                            </span>
                        </div>

                        <!-- Monospace Security On-Screen Display (OSD) - BOTTOM with Maximize Button in Bottom Right -->
                        <div class="cctv-osd-bottom">
                            <span class="cctv-osd-rec">
                                <span class="cctv-rec-dot"></span>
                                REC LIVE
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="cctv-badge @(cam.Status == "Online" ? "cctv-badge-online" : "cctv-badge-offline")"
                                      data-toggle-status="@cam.CameraId"
                                      title="Click to toggle Online/Offline">
                                    @cam.Status.ToUpperInvariant()
                                </span>
                                <!-- Maximize Icon in Bottom Right -->
                                <button type="button" class="cctv-maximize-btn" data-cctv-fullscreen title="Maximize Camera Feed">
                                    <i class="fa-solid fa-expand"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Video Card Information Footer -->
                    <div class="cctv-card-footer">
                        <div>
                            <h6 class="cctv-cam-title">@cam.CameraName</h6>
                            <span class="cctv-cam-location">
                                <i class="fa-solid fa-location-dot text-muted"></i> @cam.Location
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm py-1 px-2 @(cam.Status == "Online" ? "btn-outline-secondary text-white" : "btn-outline-success")" data-toggle-status="@cam.CameraId" title="Toggle Status">
                                @(cam.Status == "Online" ? "Offline" : "Online")
                            </button>
                            <a asp-action="EditCctv" asp-route-id="@cam.CameraId" class="btn btn-sm btn-outline-secondary text-white py-1 px-2" title="Edit">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form asp-action="DeleteCctv" asp-route-id="@cam.CameraId" method="post" data-async-delete class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State: 0 Cameras Connected -->
        <div class="text-center py-5 my-4 rounded" style="background: var(--cctv-surface); border: 1px dashed var(--cctv-border); padding: 4.5rem 2rem;">
            <div class="mb-3">
                <i class="fa-solid fa-video-slash" style="font-size: 3.5rem; color: #2e5a4b;"></i>
            </div>
            <h3 class="text-white fw-bold mb-2">0 Cameras Connected</h3>
            <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
                No surveillance cameras have been added yet. Click below to add your first camera feed URL.
            </p>
            <button type="button" class="ab-app-btn ab-app-btn-primary" data-bs-toggle="modal" data-bs-target="#addCameraModal">
                <i class="fa-solid fa-plus"></i> Add Camera
            </button>
        </div>
    }
</div>

<!-- ==========================================
     CLEAN PRO ADD CAMERA MODAL
     ========================================== -->
<div class="modal fade" id="addCameraModal" tabindex="-1" aria-labelledby="addCameraModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: #091612; border: 1px solid var(--cctv-border); color: #e2ede8;">
            <form asp-action="CreateCctv" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="border-bottom: 1px solid var(--cctv-border);">
                    <h5 class="modal-title d-flex align-items-center gap-2 text-white" id="addCameraModalLabel">
                        <i class="fa-solid fa-video text-success"></i> Add CCTV Camera
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-bold">Camera Name</label>
                            <input type="text" name="CameraName" class="form-control" style="background: #040907; border-color: var(--cctv-border); color: #fff;" placeholder="e.g. Main Entrance Gate" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-bold">Location / Zone</label>
                            <input type="text" name="Location" class="form-control" style="background: #040907; border-color: var(--cctv-border); color: #fff;" placeholder="e.g. Main Gate, Lobby, Parking" value="Main Gate" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label text-white small fw-bold mb-0">Stream URL</label>
                            <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 small" data-test-url-btn>
                                <i class="fa-solid fa-play"></i> Test URL Preview
                            </button>
                        </div>
                        <input type="text" name="StreamUrl" class="form-control cctv-input" style="background: #040907; border-color: var(--cctv-border); color: #fff; font-family: monospace;" placeholder="e.g. http://192.168.0.157:8080/video" required />
                        <small class="d-block mt-1 fw-medium" style="color: #a4c7b8; font-size: 0.825rem;">Direct stream URL (HTTP / MJPEG / MP4).</small>
                    </div>

                    <!-- Live URL Test Preview Box -->
                    <div data-url-preview-status class="small mb-2"></div>
                    <div class="cctv-modal-preview" data-url-preview-box>
                        <img data-url-preview-media src="" alt="Live Stream Preview" />
                    </div>

                    <div class="mb-2 mt-3">
                        <label class="form-label text-white small fw-bold">Status</label>
                        <select name="Status" class="form-select" style="background: #040907; border-color: var(--cctv-border); color: #fff;">
                            <option value="Online" selected>Online</option>
                            <option value="Offline">Offline</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer" style="border-top: 1px solid var(--cctv-border);">
                    <button type="button" class="ab-app-btn ab-app-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="ab-app-btn ab-app-btn-primary">
                        <i class="fa-solid fa-circle-check"></i> Save Camera
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
