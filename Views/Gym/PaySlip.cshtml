@model ADHUNIK_BARI.ViewModels.GymPaySlipViewModel
@{
    ViewData["Title"] = "Gym Fee Pay Slip - " + Model.PaySlipNumber;
}

<div class="container py-4 fade-in">
    <!-- Non-print Action Header -->
    <div class="no-print d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <div class="text-uppercase text-primary fw-bold small tracking-wide">
                <i class="fa-solid fa-file-invoice-dollar me-1"></i> Membership Billing
            </div>
            <h1 class="h3 fw-bold text-dark mb-0">Gym Membership Pay Slip</h1>
            <p class="text-muted small mb-0">Official building pay slip issued for facility access & membership validation.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary rounded-3 px-3 fw-semibold" onclick="window.print();">
                <i class="fa-solid fa-print me-1"></i> Print Pay Slip
            </button>
            @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
            {
                <a asp-controller="Manager" asp-action="Gym" class="btn btn-outline-dark rounded-3">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Manager Gym
                </a>
            }
            else
            {
                <a asp-controller="Resident" asp-action="Gym" class="btn btn-outline-dark rounded-3">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Gym Center
                </a>
            }
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Pay Slip Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mx-auto my-3" style="max-width: 820px;">
        <!-- Slip Header -->
        <div class="p-4 bg-dark text-white d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="fa-solid fa-dumbbell text-warning fs-4"></i>
                    <h4 class="fw-bold mb-0 text-white">@Model.GymName</h4>
                </div>
                <small class="text-white-50">ADHUNIK BARI AMENITIES & FITNESS CENTER</small>
            </div>
            <div class="text-end">
                <span class="badge bg-warning text-dark px-3 py-2 fw-bold font-monospace fs-6 rounded-pill">
                    OFFICIAL PAY SLIP
                </span>
                <div class="small text-white-50 mt-1 font-monospace">@Model.PaySlipNumber</div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <!-- Slip Meta Row -->
            <div class="row g-4 mb-4 pb-4 border-bottom">
                <div class="col-sm-6">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Issued To Member:</span>
                    <h5 class="fw-bold text-dark mb-1">@Model.MemberName</h5>
                    <div class="text-muted small">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill me-1">@Model.MemberRelation</span>
                        of Resident <strong>@Model.ApplicantName</strong>
                    </div>
                    <div class="text-muted small mt-1">
                        <i class="fa-solid fa-door-closed me-1 text-primary"></i>Flat @Model.FlatNumber (@Model.ResidentType)
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.MemberPhone))
                    {
                        <div class="text-muted small">
                            <i class="fa-solid fa-phone me-1 text-secondary"></i>@Model.MemberPhone
                        </div>
                    }
                </div>

                <div class="col-sm-6 text-sm-end">
                    <div class="mb-2">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Pay Slip No.:</span>
                        <span class="font-monospace fw-bold text-dark fs-6">@Model.PaySlipNumber</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Issue Date:</span>
                        <span class="text-dark small">@Model.IssuedAt.ToString("dd MMMM, yyyy")</span>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Approved By:</span>
                        <span class="text-dark small">@(Model.ApprovedByName ?? "Building Management")</span>
                    </div>
                </div>
            </div>

            <!-- Fee Item Table -->
            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Description</th>
                            <th>Membership Validity Period</th>
                            <th>Duration</th>
                            <th class="text-end">Amount (৳)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong class="text-dark d-block">Gym Facility Enrolment & Membership Fee (@Model.PackageName)</strong>
                                <small class="text-muted">Separate fitness pass for member: @Model.MemberName</small>
                            </td>
                            <td>
                                <div>@Model.StartDate.ToString("MMM dd, yyyy") &mdash; @Model.ExpiryDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>@Model.DurationDays Days (@Model.PackageName)</td>
                            <td class="text-end fw-bold fs-6">৳@Model.PaySlipAmount.ToString("N2")</td>
                        </tr>
                        <tr class="table-light">
                            <td colspan="3" class="text-end fw-bold">Total Amount Payable:</td>
                            <td class="text-end fw-extrabold text-primary fs-5">৳@Model.PaySlipAmount.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Non-Refundable Policy Alert -->
            <div class="alert alert-warning border-0 rounded-3 small mb-4 py-2 px-3">
                <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>
                <strong>Non-Refundable Policy Notice:</strong> This gym membership fee of <strong>৳@Model.PaySlipAmount.ToString("N0")</strong> is strictly <strong>non-refundable</strong> once paid.
            </div>

            <!-- Status & Action Box -->
            <div class="p-4 rounded-4 @(Model.IsPaid ? "bg-success-subtle border border-success-subtle" : "bg-warning-subtle border border-warning-subtle") mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        @if (Model.IsPaid)
                        {
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-circle-check fs-4 text-success"></i>
                                <h5 class="fw-bold text-success mb-0">Status: Active Member (Fee Paid)</h5>
                            </div>
                            <small class="text-muted d-block">
                                Paid on @(Model.FeePaidAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "N/A") via <strong>@(Model.PaymentMethod ?? "Online / Stripe")</strong>
                                @if (!string.IsNullOrWhiteSpace(Model.PaymentTransactionId))
                                {
                                    <span>(Trx: @Model.PaymentTransactionId)</span>
                                }
                            </small>
                            <small class="text-success fw-semibold mt-1 d-block">
                                <i class="fa-solid fa-id-card me-1"></i> Your Official Gym ID Card is unlocked and active!
                            </small>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-clock-rotate-left fs-4 text-warning-emphasis"></i>
                                <h5 class="fw-bold text-dark mb-0">Status: Pending Payment</h5>
                            </div>
                            <small class="text-muted d-block">
                                Status is currently <strong>Pending</strong>. Pay this ৳@Model.PaySlipAmount.ToString("N0") fee to automatically become an <strong>Active Member</strong> and unlock your ID Card.
                            </small>
                            <small class="text-danger fw-semibold d-block mt-1">
                                <i class="fa-solid fa-circle-exclamation me-1"></i> Note: This membership fee is strictly non-refundable for residents.
                            </small>
                        }
                    </div>

                    <div class="no-print">
                        @if (Model.IsPaid)
                        {
                            <a asp-controller="@(User.IsInRole("Manager") || User.IsInRole("Admin") ? "Manager" : "Resident")" 
                               asp-action="GymIdCard" 
                               asp-route-id="@Model.MembershipId" 
                               class="btn btn-success btn-lg rounded-3 fw-bold shadow-sm">
                                <i class="fa-solid fa-id-card me-2"></i> Get Member ID Card
                            </a>
                        }
                        else
                        {
                            @if (!User.IsInRole("Manager") && !User.IsInRole("Admin"))
                            {
                                <button type="button" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm px-4" data-bs-toggle="modal" data-bs-target="#paySlipModal">
                                    <i class="fa-brands fa-stripe me-2"></i> Pay ৳@Model.PaySlipAmount.ToString("N0") via Stripe
                                </button>
                            }
                            else
                            {
                                <div class="text-md-end">
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-2 px-3 fs-6">
                                        <i class="fa-solid fa-clock me-1"></i> Awaiting Resident Payment (৳@Model.PaySlipAmount.ToString("N0"))
                                    </span>
                                    <small class="text-muted d-block mt-1">Status remains Pending until resident pays online. Auto-activates upon payment.</small>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Notice & Instructions -->
            <div class="row g-3 small text-muted">
                <div class="col-md-6">
                    <strong class="text-dark d-block mb-1"><i class="fa-solid fa-circle-info text-primary me-1"></i>Important Notice:</strong>
                    This pay slip is separate from standard flat utility and service bills. Gym access is granted individually per registered member upon clearance of this fee.
                </div>
                <div class="col-md-6 text-md-end">
                    <strong class="text-dark d-block mb-1">Building Management Office</strong>
                    Adhunik Bari Residential Complex<br />
                    Helpline: +880 1700-000000 &bull; info@adhunikbari.com
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PAYMENT MODAL FOR RESIDENT (STRIPE SYSTEM) -->
@if (!Model.IsPaid)
{
    <div class="modal fade" id="paySlipModal" tabindex="-1" aria-labelledby="paySlipModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom p-4">
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mb-1">
                            <i class="fa-brands fa-stripe me-1"></i> Stripe Checkout
                        </span>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="paySlipModalLabel">
                            Pay Gym Fee Slip
                        </h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Slip Summary Banner -->
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Pay Slip No.:</small>
                                <span class="font-monospace fw-bold text-dark">@Model.PaySlipNumber</span>
                                <small class="text-secondary d-block mt-1">
                                    Member: <strong>@Model.MemberName</strong> (@Model.MemberRelation)
                                </small>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">Payable Fee:</small>
                                <strong class="fs-3 text-primary fw-extrabold">৳@Model.PaySlipAmount.ToString("N0")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 rounded-3 small mb-2">
                        <i class="fa-solid fa-id-card text-primary me-2"></i>
                        Status is currently <strong>Pending Payment</strong>. When this ৳@Model.PaySlipAmount.ToString("N0") fee is paid, your status automatically moves to <strong>Active Member</strong> and your <strong>Official Gym Member ID Card</strong> with scannable QR verification code is unlocked!
                    </div>

                    <div class="alert alert-warning border-0 rounded-3 small mb-3 py-2 px-3">
                        <i class="fa-solid fa-triangle-exclamation text-warning me-1"></i>
                        <strong>Notice:</strong> This gym membership fee (৳@Model.PaySlipAmount.ToString("N0")) is <strong>strictly non-refundable</strong> once payment is processed.
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.PublishableKey) && !string.IsNullOrWhiteSpace(Model.ClientSecret))
                    {
                        <!-- STRIPE PAYMENT FORM -->
                        <form id="gym-stripe-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="membershipId" value="@Model.MembershipId" />

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted text-uppercase d-flex justify-content-between">
                                    <span>Credit or Debit Card</span>
                                    <span class="text-primary"><i class="fa-brands fa-stripe fs-5 align-middle"></i></span>
                                </label>
                                <div id="stripe-card-element" class="form-control p-3 rounded-3 border"></div>
                                <div id="stripe-card-errors" class="text-danger small mt-2" role="alert"></div>
                            </div>

                            <div id="stripe-processing-msg" class="d-none alert alert-light border text-center py-2 mb-3">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="small fw-semibold text-muted">Confirming with Stripe & unlocking your ID Card...</span>
                            </div>

                            <button id="stripe-pay-btn" type="submit" class="btn btn-primary btn-lg rounded-3 w-100 fw-bold shadow-sm">
                                <i class="fa-brands fa-stripe me-2"></i> Pay ৳@Model.PaySlipAmount.ToString("N0") via Stripe
                            </button>
                        </form>
                    }
                    else
                    {
                        <!-- Direct simulation payment if Stripe test secret key is offline -->
                        <div class="p-3 border rounded-3 bg-light text-center">
                            <i class="fa-brands fa-stripe fs-2 text-primary mb-2"></i>
                            <h6 class="fw-bold mb-1">Stripe Payment Gateway</h6>
                            <p class="small text-muted mb-3">Click below to submit ৳@Model.PaySlipAmount.ToString("N0") payment and immediately receive your Gym Member ID Card.</p>
                            <form id="gym-fallback-form" asp-controller="Gym" asp-action="ConfirmStripePayment" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="membershipId" value="@Model.MembershipId" />
                                <input type="hidden" name="paymentIntentId" value="@(Model.StripePaymentIntentId ?? "SIM-STRIPE-" + Guid.NewGuid().ToString("N")[..8])" />
                                <button type="submit" class="btn btn-primary btn-lg rounded-3 w-100 fw-bold shadow-sm">
                                    <i class="fa-brands fa-stripe me-2"></i> Confirm ৳@Model.PaySlipAmount.ToString("N0") Payment
                                </button>
                            </form>
                        </div>
                    }
                </div>

                <div class="modal-footer p-3 border-top bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .cursor-pointer {
        cursor: pointer;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        .card, .card * {
            visibility: visible;
        }

        .card {
            position: absolute;
            left: 0;
            top: 0;
            width: 100% !important;
            box-shadow: none !important;
            border: 1px solid #000 !important;
        }

        .no-print {
            display: none !important;
        }
    }
</style>

@section Scripts {
    @if (!Model.IsPaid && !string.IsNullOrWhiteSpace(Model.PublishableKey) && !string.IsNullOrWhiteSpace(Model.ClientSecret))
    {
        <script src="https://js.stripe.com/v3/"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('gym-stripe-form');
                if (!form) return;

                const stripe = Stripe('@Model.PublishableKey');
                const elements = stripe.elements();
                const card = elements.create('card', {
                    style: {
                        base: {
                            fontSize: '16px',
                            color: '#32325d',
                            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
                            '::placeholder': { color: '#aab7c4' }
                        },
                        invalid: {
                            color: '#fa755a',
                            iconColor: '#fa755a'
                        }
                    }
                });

                card.mount('#stripe-card-element');

                const payBtn = document.getElementById('stripe-pay-btn');
                const errorElement = document.getElementById('stripe-card-errors');
                const processingMsg = document.getElementById('stripe-processing-msg');

                card.on('change', function (event) {
                    if (event.error) {
                        errorElement.textContent = event.error.message;
                    } else {
                        errorElement.textContent = '';
                    }
                });

                form.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    payBtn.disabled = true;
                    errorElement.textContent = '';
                    if (processingMsg) processingMsg.classList.remove('d-none');

                    try {
                        const result = await stripe.confirmCardPayment('@Model.ClientSecret', {
                            payment_method: { card: card }
                        });

                        if (result.error) {
                            errorElement.textContent = result.error.message || 'Payment failed. Please check your card details.';
                            payBtn.disabled = false;
                            if (processingMsg) processingMsg.classList.add('d-none');
                            return;
                        }

                        if (!result.paymentIntent || result.paymentIntent.status !== 'succeeded') {
                            errorElement.textContent = 'Stripe has not confirmed payment completion. Status: ' + (result.paymentIntent ? result.paymentIntent.status : 'Unknown');
                            payBtn.disabled = false;
                            if (processingMsg) processingMsg.classList.add('d-none');
                            return;
                        }

                        // Call server to confirm payment and unlock ID card
                        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
                        const body = new URLSearchParams();
                        body.append('__RequestVerificationToken', token);
                        body.append('membershipId', '@Model.MembershipId');
                        body.append('paymentIntentId', result.paymentIntent.id);

                        const response = await fetch('@Url.Action("ConfirmStripePayment", "Gym")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                            body: body.toString()
                        });

                        const data = await response.json();
                        if (!response.ok || !data.success) {
                            errorElement.textContent = data.message || 'Payment received by Stripe, but finalization encountered an issue.';
                            payBtn.disabled = false;
                            if (processingMsg) processingMsg.classList.add('d-none');
                            return;
                        }

                        // Redirect directly to the generated ID Card!
                        window.location.href = data.redirectUrl;
                    } catch (err) {
                        console.error('Stripe error:', err);
                        errorElement.textContent = 'An unexpected error occurred during payment processing.';
                        payBtn.disabled = false;
                        if (processingMsg) processingMsg.classList.add('d-none');
                    }
                });
            });
        </script>
    }
}
