@model ADHUNIK_BARI.ViewModels.ParkingBookingSuccessViewModel
@{
    ViewData["Title"] = "Parking Booking Confirmed - Space " + Model.SpotNumber;
}

<div class="public-marketplace-page">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-center p-4 p-md-5">
                    <div class="mb-4">
                        <div style="display: inline-flex; align-items: center; justify-content: center; width: 88px; height: 88px; border-radius: 50%; background: #dcfce7; color: #16a34a; font-size: 40px; margin: 0 auto; box-shadow: 0 0 0 12px #f0fdf4;">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>

                    <div class="property-eyebrow text-success mb-1">
                        <i class="fa-solid fa-badge-check me-1"></i>Advance Payment &amp; Reservation Confirmed
                    </div>
                    <h1 class="h2 fw-bold mb-2">Parking Space Booked!</h1>
                    <p class="text-muted mb-4">
                        @if (Model.IsOutsider)
                        {
                            <span>Space <strong>@Model.SpotNumber</strong> has been successfully booked and allocated to <strong>@Model.ResidentName</strong>.</span>
                        }
                        else
                        {
                            <span>Space <strong>@Model.SpotNumber</strong> has been successfully booked and allocated to <strong>@Model.FlatNumber</strong>.</span>
                        }
                    </p>

                    <!-- Receipt Slip -->
                    <div class="card border rounded-4 bg-light p-4 text-start mb-4">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                            <div>
                                <span class="small text-muted d-block">Booking Reference</span>
                                <strong class="font-monospace text-primary">@Model.BookingReference</strong>
                            </div>
                            @if (Model.IsOutsider)
                            {
                                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold">
                                    <i class="fa-solid fa-user-check me-1"></i>External Parking Member
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                                    <i class="fa-solid fa-link me-1"></i>Assigned to Flat
                                </span>
                            }
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <span class="small text-muted d-block">Parking Bay</span>
                                <strong class="fs-5">@Model.SpotNumber</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="small text-muted d-block">Level / Floor</span>
                                <strong>@Model.FloorName</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="small text-muted d-block">Allocation Target</span>
                                @if (Model.IsOutsider)
                                {
                                    <strong class="text-primary">@Model.ResidentName (Outsider)</strong>
                                }
                                else
                                {
                                    <strong class="text-success">@Model.FlatNumber</strong>
                                }
                            </div>
                            <div class="col-sm-6">
                                <span class="small text-muted d-block">Vehicle Type</span>
                                <strong>@Model.VehicleType @(!string.IsNullOrWhiteSpace(Model.VehicleRegNumber) ? $"({Model.VehicleRegNumber})" : "")</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="small text-muted d-block">Advance Paid</span>
                                <strong class="text-success fs-5">৳@Model.AdvanceAmount.ToString("N0")</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="small text-muted d-block">Date of Payment</span>
                                <strong>@Model.BookedAt.ToString("dd MMM yyyy, hh:mm tt")</strong>
                            </div>
                        </div>
                    </div>

                    @if (Model.IsOutsider)
                    {
                        <div class="alert alert-success border-0 rounded-4 text-start mb-4 shadow-sm">
                            <div class="d-flex gap-3 align-items-start">
                                <div class="bg-white text-success rounded-circle p-2 mt-1 shadow-xs">
                                    <i class="fa-solid fa-key fs-5"></i>
                                </div>
                                <div class="small w-100">
                                    <strong class="fs-6 d-block mb-1">Your Dedicated Parking Account is Ready!</strong>
                                    <div>An account has been prepared for email: <strong>@Model.GeneratedAccountEmail</strong>.</div>
                                    @if (!string.IsNullOrEmpty(Model.TemporaryPassword))
                                    {
                                        <div class="p-3 bg-white border border-success-subtle rounded-3 my-2 shadow-xs">
                                            <div class="small text-muted mb-1">Your Account Credentials (also sent via email):</div>
                                            <div class="mb-1"><strong>Username / Email:</strong> <code class="user-select-all text-dark">@Model.GeneratedAccountEmail</code></div>
                                            <div><strong>Temporary Password:</strong> <span class="badge bg-success-subtle text-success fs-6 font-monospace px-2 py-1 user-select-all">@Model.TemporaryPassword</span></div>
                                        </div>
                                    }
                                    <div>Your temporary password and direct sign-in instructions have been sent to your email.</div>
                                    <div class="mt-2 text-muted">
                                        <i class="fa-solid fa-circle-info me-1"></i>As an external parking member, logging in gives you access exclusively to view your allocated parking bay and your billing/payment statements.
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info border-0 rounded-4 text-start mb-4">
                            <div class="d-flex gap-3 align-items-start">
                                <i class="fa-solid fa-bell text-primary fs-5 mt-1"></i>
                                <div class="small">
                                    <strong>What happens next?</strong><br />
                                    Your parking space is immediately reflected in your resident profile and the visual basement parking grid. Confirmation details have been emailed to your address.
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        @if (Model.IsOutsider)
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-email="@Model.GeneratedAccountEmail" asp-route-forceLogout="true" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                                <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In to Parking Portal
                            </a>
                        }
                        else if (Model.IsLoggedIn)
                        {
                            <a asp-controller="Resident" asp-action="Dashboard" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                                <i class="fa-solid fa-gauge me-2"></i>View in My Dashboard
                            </a>
                        }
                        <a asp-controller="Property" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                            <i class="fa-solid fa-house me-2"></i>Back to Marketplace
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

