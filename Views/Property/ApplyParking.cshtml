@model ADHUNIK_BARI.ViewModels.ApplyParkingViewModel
@{
    ViewData["Title"] = $"Book Parking Spot {Model.SpotNumber}";
    var isToLet = Model.ListingType == PropertyListingTypes.ToLet;
}

<div class="public-marketplace-page">
    <div class="container py-4 py-lg-5">
        <div class="mb-4">
            <a asp-action="ParkingDetails" asp-route-id="@Model.ParkingSpotId" class="public-back-link">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to parking space details
            </a>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-lg-5">
                        <div class="property-eyebrow">
                            <i class="fa-solid fa-square-parking me-2"></i>Parking Reservation &amp; Assignment
                        </div>
                        <h1 class="h2 fw-bold mt-2">
                            @(isToLet ? "Book Parking Space (To-Let)" : "Reserve Parking Space (For Sale)")
                        </h1>
                        <p class="text-muted">
                            Spot @Model.SpotNumber · @Model.FloorName · @Model.VehicleType
                        </p>

                        <!-- Summary Banner -->
                        <div class="alert alert-primary border-0 rounded-4 d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                            <div>
                                <div class="small opacity-75">@(isToLet ? "Monthly Rental Rate" : "Asking Price")</div>
                                <div class="fs-4 fw-bold">৳@Model.Price.ToString("N0") @(isToLet ? "/ mo" : "")</div>
                            </div>
                            <div class="text-end">
                                <div class="small opacity-75">Advance / Token Booking Deposit</div>
                                <div class="fs-5 fw-bold">৳@Model.AdvanceAmount.ToString("N0")</div>
                            </div>
                        </div>

                        <!-- Resident Status Banner -->
                        @if (Model.IsLoggedInResident)
                        {
                            <div class="alert alert-success border-0 rounded-4 d-flex align-items-center gap-3 mb-4">
                                <div class="fs-3 text-success">
                                    <i class="fa-solid fa-circle-check"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">Active Resident Identified</div>
                                    <div class="small text-muted">
                                        Logged in as <strong>@Model.FullName</strong> · Assigned Flat: <span class="badge bg-success-subtle text-success">Flat @Model.SelectedFlatNumber</span> (@Model.ResidentRole)
                                    </div>
                                    <div class="small text-muted mt-1">
                                        This parking bay will be automatically allocated to Flat @Model.SelectedFlatNumber.
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info border-0 rounded-4 d-flex align-items-center gap-3 mb-4">
                                <i class="fa-solid fa-info-circle fs-4 text-primary"></i>
                                <div class="small">
                                    Are you a resident of ADHUNIK BARI?
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="fw-bold text-decoration-underline ms-1">
                                        Sign in
                                    </a> for 1-click automatic flat linking, or enter your resident details below.
                                </div>
                            </div>
                        }

                        <form asp-action="ApplyParking" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <input asp-for="ParkingSpotId" type="hidden" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4"></div>

                            <div class="row g-3">
                                <!-- Resident Identification -->
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                                    <input asp-for="FullName" class="form-control rounded-3" placeholder="e.g. Abdullah Noman" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-semibold"></label>
                                    <input asp-for="Email" class="form-control rounded-3" placeholder="e.g. resident@adhunikbari.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label fw-semibold"></label>
                                    <input asp-for="Phone" class="form-control rounded-3" placeholder="e.g. +880 1712 345678" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <!-- Flat Selection -->
                                <div class="col-md-6">
                                    <label asp-for="FlatId" class="form-label fw-semibold">
                                        Your Flat in Building <span class="text-muted fw-normal">(Optional for outsiders / external buyers)</span>
                                    </label>
                                    @if (Model.IsLoggedInResident)
                                    {
                                        <input asp-for="FlatId" type="hidden" />
                                        <input type="text" class="form-control rounded-3 bg-light" value="Flat @Model.SelectedFlatNumber (@Model.ResidentRole)" readonly />
                                    }
                                    else
                                    {
                                        <select asp-for="FlatId" asp-items="Model.AvailableFlats" class="form-select rounded-3">
                                            <option value="">-- No Flat (External Person / Outsider) --</option>
                                        </select>
                                        <span asp-validation-for="FlatId" class="text-danger small"></span>
                                    }
                                </div>

                                <!-- Vehicle Details -->
                                <div class="col-md-6">
                                    <label asp-for="VehicleType" class="form-label fw-semibold">Vehicle Type</label>
                                    <select asp-for="VehicleType" class="form-select rounded-3">
                                        <option value="Car">Car / Sedan</option>
                                        <option value="SUV">SUV / Jeep</option>
                                        <option value="Motorbike">Motorbike</option>
                                        <option value="Bicycle">Bicycle</option>
                                    </select>
                                    <span asp-validation-for="VehicleType" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="VehicleRegNumber" class="form-label fw-semibold">Vehicle Registration No. (Optional)</label>
                                    <input asp-for="VehicleRegNumber" class="form-control rounded-3 font-monospace" placeholder="e.g. Dhaka Metro-GA 12-3456" />
                                    <span asp-validation-for="VehicleRegNumber" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ExpectedStartDate" class="form-label fw-semibold">Move-in / Start Date</label>
                                    <input asp-for="ExpectedStartDate" type="date" class="form-control rounded-3" />
                                    <span asp-validation-for="ExpectedStartDate" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Assigned Basement Floor</label>
                                    <input type="text" class="form-control rounded-3 bg-light" value="@Model.FloorName (Spot @Model.SpotNumber)" readonly />
                                </div>

                                <div class="col-12">
                                    <label asp-for="Notes" class="form-label fw-semibold">Notes / Special Requirements (Optional)</label>
                                    <textarea asp-for="Notes" class="form-control rounded-3" rows="2" placeholder="e.g. Charging outlet needed, specific vehicle dimensions..."></textarea>
                                </div>

                                <div class="col-12">
                                    <div class="form-check p-3 border rounded-3 bg-light mt-2">
                                        <input asp-for="TermsAccepted" class="form-check-input ms-0 me-2" type="checkbox" id="termsCheck" />
                                        <label for="termsCheck" class="form-check-label small">
                                            I agree to the advance payment of <strong>৳@Model.AdvanceAmount.ToString("N0")</strong> to reserve parking space <strong>@Model.SpotNumber</strong> on <strong>@Model.FloorName</strong>. Building garage regulations apply.
                                        </label>
                                        <div><span asp-validation-for="TermsAccepted" class="text-danger small"></span></div>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 mt-4 fw-semibold shadow-sm">
                                <i class="fa-solid fa-lock me-2"></i>Proceed to Secure Payment (৳@Model.AdvanceAmount.ToString("N0"))
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

