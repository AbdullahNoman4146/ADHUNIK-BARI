@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<section class="ab-simple-page">
    <div class="container">
        <div class="ab-simple-card ab-error-card">
            <span class="ab-error-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
            <div class="ab-eyebrow"><span></span> A temporary interruption</div>
            <h1>That page could not be completed.</h1>
            <p class="ab-simple-lead">Your information has not been changed. Return home and try the action again in a moment.</p>
            @if (Model.ShowRequestId) { <p class="ab-request-id">Reference: <code>@Model.RequestId</code></p> }
            <a class="ab-button ab-button-dark" asp-controller="Home" asp-action="Index">Return home <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>
