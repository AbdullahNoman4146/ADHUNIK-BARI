@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isManager = User.IsInRole("Manager") || User.IsInRole("Admin");
    var userName = User.Identity?.Name ?? "Account";
    var userInitial = !string.IsNullOrWhiteSpace(userName) ? userName[..1].ToUpperInvariant() : "A";
}
@if (isAuthenticated)
{
    <nav class="ab-app-topbar" aria-label="Workspace controls">
        <div class="ab-topbar-left">
            <button class="ab-sidebar-toggle" type="button" data-sidebar-toggle aria-label="Open workspace navigation" aria-expanded="false">
                <i class="fa-solid fa-bars-staggered"></i>
            </button>
            <div class="ab-topbar-context">
                <small>@(isManager ? "MANAGEMENT WORKSPACE" : "RESIDENT SPACE")</small>
                <strong>@ViewData["Title"]</strong>
            </div>
        </div>
        <div class="ab-topbar-actions">
            <div class="ab-topbar-date d-none d-md-flex"><i class="fa-regular fa-calendar"></i><span data-current-date>@DateTime.Now.ToString("ddd, dd MMM")</span></div>
            <a class="ab-topbar-market" asp-controller="Property" asp-action="Index" title="Open public marketplace"><i class="fa-solid fa-arrow-up-right-from-square"></i><span class="d-none d-lg-inline">Marketplace</span></a>
            <div class="dropdown">
                <button class="ab-topbar-profile dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Open account menu">
                    <span class="ab-topbar-avatar">@userInitial</span>
                    <span class="ab-topbar-user d-none d-sm-grid"><strong>@userName</strong><small>@(isManager ? "Manager" : "Resident")</small></span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end ab-dropdown ab-topbar-dropdown">
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="fa-solid fa-shield-halved"></i> Account security</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-globe"></i> Public website</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><form method="post" asp-controller="Account" asp-action="Logout">@Html.AntiForgeryToken()<button type="submit" class="dropdown-item ab-logout-item"><i class="fa-solid fa-arrow-right-from-bracket"></i> Sign out</button></form></li>
                </ul>
            </div>
        </div>
    </nav>
}
else
{
    <nav class="navbar navbar-expand-xl adhunik-nav sticky-top" aria-label="Primary navigation" data-site-nav>
        <div class="container-fluid ab-nav-inner">
            <a class="navbar-brand ab-brand" asp-controller="Home" asp-action="Index" aria-label="ADHUNIK BARI home"><span class="ab-brand-mark" aria-hidden="true"><span>AB</span><i></i></span><span class="ab-brand-copy"><strong>ADHUNIK BARI</strong><small>Connected living</small></span></a>
            <button class="navbar-toggler ab-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu" aria-controls="navbarMenu" aria-expanded="false" aria-label="Open navigation menu"><span></span><span></span></button>
            <div class="collapse navbar-collapse" id="navbarMenu">
                <ul class="navbar-nav ms-auto align-items-xl-center ab-nav-links">
                    <li class="nav-item"><a class="nav-link" asp-controller="Property" asp-action="Index"><i class="fa-solid fa-building" aria-hidden="true"></i> Marketplace</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#features">Platform</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#how-it-works">How it works</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    <li class="nav-item ab-nav-cta-item"><a class="ab-button ab-button-small ab-button-light" asp-controller="Account" asp-action="Login">Open portal <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></li>
                </ul>
            </div>
        </div>
    </nav>
}
