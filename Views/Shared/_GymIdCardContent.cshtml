@model ADHUNIK_BARI.ViewModels.GymIdCardViewModel

<div class="gym-id-card-wrapper my-4">
    <!-- FRONT OF THE CARD -->
    <div class="card gym-id-card shadow-lg border-0 rounded-4 overflow-hidden mx-auto position-relative">
        <!-- Top Gradient Accent Bar -->
        <div class="gym-card-topbar d-flex justify-content-between align-items-center px-4 py-2">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-dumbbell text-warning fs-5"></i>
                <span class="text-white fw-bold tracking-wide small text-uppercase">@Model.GymName</span>
            </div>
            <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1 font-monospace small">
                OFFICIAL MEMBER PASS
            </span>
        </div>

        <!-- Main Card Body -->
        <div class="card-body p-4 position-relative">
            <!-- Background Watermark Logo -->
            <div class="watermark-icon position-absolute end-0 bottom-0 text-muted opacity-10 pe-3 pb-2" style="pointer-events: none; z-index: 0;">
                <i class="fa-solid fa-dumbbell" style="font-size: 11rem; line-height: 1;"></i>
            </div>

            <div class="row align-items-center position-relative" style="z-index: 1;">
                <!-- Left: Member Photo / Avatar & Basic Info -->
                <div class="col-md-4 col-sm-5 text-center border-end-sm pe-sm-3 mb-3 mb-sm-0">
                    <div class="avatar-holder mx-auto mb-2 rounded-circle d-flex align-items-center justify-content-center shadow-sm position-relative overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(Model.MemberPhotoUrl))
                        {
                            <img src="@Model.MemberPhotoUrl" alt="@Model.MemberName" class="w-100 h-100 object-fit-cover rounded-circle" />
                        }
                        else
                        {
                            <i class="fa-solid fa-user-tie fs-1 text-primary"></i>
                        }
                        <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-1" title="Active" style="z-index: 2;">
                            <span class="visually-hidden">Active</span>
                        </span>
                    </div>

                    <h5 class="fw-bold text-dark mb-0 text-truncate" title="@Model.MemberName">@Model.MemberName</h5>
                    
                    <div class="small text-muted mb-1">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0">
                            @Model.MemberRelation
                        </span>
                        @if (!string.Equals(Model.MemberRelation, "Self", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="d-block text-truncate small" title="Resident: @Model.ApplicantName">Res: @Model.ApplicantName</span>
                        }
                    </div>

                    <div class="text-muted small mb-1">
                        <i class="fa-solid fa-door-closed text-primary me-1"></i>Flat @Model.FlatNumber
                    </div>

                    <!-- Basic Demographic Info -->
                    @if (!string.IsNullOrWhiteSpace(Model.MemberGender) || Model.MemberAge.HasValue)
                    {
                        <div class="small text-secondary mb-2">
                            @if (!string.IsNullOrWhiteSpace(Model.MemberGender))
                            {
                                <span>@Model.MemberGender</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.MemberGender) && Model.MemberAge.HasValue)
                            {
                                <span> &bull; </span>
                            }
                            @if (Model.MemberAge.HasValue)
                            {
                                <span>@Model.MemberAge yrs</span>
                            }
                        </div>
                    }

                    <div class="pt-2 border-top">
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold small">
                            <i class="fa-solid fa-shield-halved me-1"></i>VERIFIED ACTIVE
                        </span>
                    </div>
                </div>

                <!-- Center: Membership Card Details & Prominent Expiry -->
                <div class="col-md-5 col-sm-7 ps-sm-3 pe-md-2 border-end-md">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <small class="text-muted text-uppercase fw-semibold d-block">Membership Pass No.</small>
                            <span class="fs-6 fw-bold font-monospace text-primary">@Model.CardNumber</span>
                        </div>
                        <div class="text-end">
                            <small class="text-muted text-uppercase fw-semibold d-block">Access Hours</small>
                            <span class="badge bg-dark text-white rounded-pill px-2 py-1 small">@Model.OpeningHours</span>
                        </div>
                    </div>

                    <!-- PROMINENT EXPIRATION HIGHLIGHT BOX -->
                    <div class="expiry-highlight-box p-3 rounded-3 my-2 text-center border shadow-sm">
                        <div class="text-uppercase fw-bold text-danger small tracking-wider mb-1">
                            <i class="fa-solid fa-calendar-xmark me-1"></i> MEMBERSHIP EXPIRES ON
                        </div>
                        <div class="h4 fw-extrabold text-danger font-monospace mb-1">
                            @Model.ExpiryDate.ToString("dd MMMM, yyyy")
                        </div>
                        <div class="d-flex justify-content-center align-items-center gap-2 text-muted small">
                            <span>From: @Model.StartDate.ToString("MMM dd, yyyy")</span>
                            <span>&bull;</span>
                            <span class="fw-bold">
                                @if (Model.DaysRemaining > 0)
                                {
                                    <span class="text-success"><i class="fa-solid fa-clock me-1"></i>@Model.DaysRemaining days left</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>Expires Today</span>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Additional Details Grid -->
                    <div class="row g-1 small text-muted mb-2">
                        <div class="col-12 text-truncate">
                            <i class="fa-solid fa-location-dot text-primary me-1"></i><strong>Location:</strong> @Model.Location
                        </div>
                        <div class="col-6 text-truncate">
                            <i class="fa-solid fa-signature text-secondary me-1"></i><strong>Approved:</strong> @Model.ApprovedByName
                        </div>
                        <div class="col-6 text-truncate">
                            <i class="fa-solid fa-phone text-secondary me-1"></i><strong>Helpline:</strong> @(Model.EmergencyPhone ?? "+880 1700-000000")
                        </div>
                    </div>

                    <!-- Barcode Visual Strip -->
                    <div class="barcode-strip text-center mt-2 pt-1 border-top">
                        <div class="fake-barcode mx-auto mb-1">
                            <span class="b-bar b-1"></span><span class="b-bar b-3"></span><span class="b-bar b-2"></span><span class="b-bar b-1"></span>
                            <span class="b-bar b-4"></span><span class="b-bar b-1"></span><span class="b-bar b-2"></span><span class="b-bar b-3"></span>
                            <span class="b-bar b-1"></span><span class="b-bar b-2"></span><span class="b-bar b-4"></span><span class="b-bar b-1"></span>
                            <span class="b-bar b-3"></span><span class="b-bar b-2"></span><span class="b-bar b-1"></span><span class="b-bar b-4"></span>
                            <span class="b-bar b-2"></span><span class="b-bar b-1"></span><span class="b-bar b-3"></span><span class="b-bar b-2"></span>
                            <span class="b-bar b-4"></span><span class="b-bar b-1"></span><span class="b-bar b-2"></span><span class="b-bar b-3"></span>
                        </div>
                        <small class="text-muted font-monospace d-block" style="font-size: 0.7rem;">* @Model.CardNumber *</small>
                    </div>
                </div>

                <!-- Right: LIVE SCANNABLE QR CODE FOR PHONE SCAN -->
                <div class="col-md-3 text-center ps-md-3 mt-3 mt-md-0">
                    <div class="qr-container bg-light p-2 rounded-3 border d-inline-block shadow-sm">
                        <img src="@(string.IsNullOrWhiteSpace(Model.QrCodeUrl) ? "/images/gym-qr-code.png" : Model.QrCodeUrl)" 
                             alt="Scan with phone to verify member pass" 
                             class="img-fluid rounded-2 bg-white p-1 qr-code-image" 
                             style="width: 125px; height: 125px; object-fit: contain; image-rendering: -webkit-optimize-contrast;" />
                        <div class="mt-1">
                            <span class="badge bg-dark text-white font-monospace text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">
                                <i class="fa-solid fa-qrcode me-1 text-warning"></i>SCAN TO VERIFY
                            </span>
                        </div>
                        <small class="text-muted font-monospace d-block mt-1" style="font-size: 0.7rem;">@Model.VerificationCode</small>
                    </div>

                    <div class="no-print mt-2 d-flex flex-column gap-1">
                        <a href="@(!string.IsNullOrWhiteSpace(Model.VerificationUrl) ? Model.VerificationUrl : "https://q.me-qr.com/y8mmqmuz")" target="_blank" class="small text-primary text-decoration-none fw-semibold">
                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Test Scan Link
                        </a>
                        @if (!string.IsNullOrWhiteSpace(Model.VerificationCode))
                        {
                            <a href="/Gym/Verify?code=@Model.VerificationCode" target="_blank" class="small text-muted text-decoration-none" style="font-size: 0.72rem;">
                                <i class="fa-solid fa-shield-halved me-1 text-success"></i>System Portal Check
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Footer of Card -->
        <div class="card-footer bg-light border-top px-4 py-2 d-flex justify-content-between align-items-center small text-muted">
            <span><i class="fa-solid fa-circle-info me-1"></i> Non-transferable. Scan QR to verify validity on entrance.</span>
            <span>Adhunik Bari System</span>
        </div>
    </div>
</div>

<style>
    .gym-id-card {
        max-width: 820px;
        background: #ffffff;
        border: 2px solid #e2e8f0 !important;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08) !important;
    }

    .gym-card-topbar {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    }

    .avatar-holder {
        width: 85px;
        height: 85px;
        background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
        border: 3px solid #ffffff;
    }

    .border-end-sm {
        border-right: 1px dashed #cbd5e1;
    }

    .border-end-md {
        border-right: 1px dashed #cbd5e1;
    }

    .expiry-highlight-box {
        background: #fff5f5;
        border: 2px dashed #feb2b2 !important;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .tracking-wide {
        letter-spacing: 0.08em;
    }

    .tracking-wider {
        letter-spacing: 0.12em;
    }

    .fake-barcode {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        height: 28px;
    }

    .b-bar {
        background-color: #1e293b;
        height: 100%;
        display: inline-block;
    }

    .b-1 { width: 1.5px; }
    .b-2 { width: 3px; }
    .b-3 { width: 4.5px; }
    .b-4 { width: 6px; }

    @@media (max-width: 767.98px) {
        .border-end-md {
            border-right: none;
            border-bottom: 1px dashed #cbd5e1;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }
    }

    @@media (max-width: 575.98px) {
        .border-end-sm {
            border-right: none;
            border-bottom: 1px dashed #cbd5e1;
            padding-bottom: 1.25rem;
        }
    }

    /* PRINT STYLESHEET */
    @@media print {
        body * {
            visibility: hidden;
        }

        .gym-id-card-wrapper,
        .gym-id-card-wrapper * {
            visibility: visible;
        }

        .gym-id-card-wrapper {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0 !important;
            padding: 20px 0 !important;
        }

        .gym-id-card {
            max-width: 820px;
            margin: 0 auto !important;
            border: 2px solid #000 !important;
            box-shadow: none !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .no-print {
            display: none !important;
        }
    }
</style>
