@{
    ViewData["Title"] = "Privacy";
}
<section class="ab-simple-page">
    <div class="container">
        <article class="ab-simple-card">
            <div class="ab-eyebrow"><span></span> Your information</div>
            <h1>Privacy at ADHUNIK BARI</h1>
            <p class="ab-simple-lead">Apartment information is personal. The platform is designed to show each person only the building, billing and service information appropriate to their account.</p>
            <div class="ab-legal-grid">
                <section><i class="fa-solid fa-user-shield"></i><div><h2>Role-based access</h2><p>Managers and residents have separate workspaces so operational and household information stays in the right context.</p></div></section>
                <section><i class="fa-solid fa-database"></i><div><h2>Purposeful records</h2><p>Account, flat, payment and service records are used to provide the features available inside the platform.</p></div></section>
                <section><i class="fa-solid fa-key"></i><div><h2>Secure credentials</h2><p>Keep your sign-in details private and contact your building manager if you believe your account access has been compromised.</p></div></section>
            </div>
            <p class="ab-legal-note">For questions about a specific building record or account, contact your ADHUNIK BARI building administrator.</p>
        </article>
    </div>
</section>
