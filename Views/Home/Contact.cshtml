@{
    ViewData["Title"] = "Contact Us";
}


<div class="contact-page">


    <!-- Header -->
    <section class="contact-hero">

        <h1>
            Contact ADHUNIK BARI
        </h1>

        <p>
            Smart Apartment Management Support
        </p>

    </section>




    <!-- Contact Information -->

    <div class="contact-container">


        <!-- Management Office -->

        <div class="contact-card">

            <div class="icon">
                🏢
            </div>

            <h3>
                Management Office
            </h3>

            <p>
                ADHUNIK BARI Apartment Complex
            </p>

            <p>
                Smart Apartment Management Team
            </p>

        </div>





        <!-- Phone -->

        <div class="contact-card">

            <div class="icon">
                ☎
            </div>

            <h3>
                Phone
            </h3>

            <p>
                +880 1XXXXXXXXX
            </p>

            <p>
                Available during office hours
            </p>

        </div>





        <!-- Email -->

        <div class="contact-card">

            <div class="icon">
                ✉
            </div>

            <h3>
                Support Email
            </h3>

            <p>
                support@adhunikbari.com
            </p>

        </div>





        <!-- Address -->

        <div class="contact-card">

            <div class="icon">
                📍
            </div>

            <h3>
                Address
            </h3>

            <p>
                ADHUNIK BARI Apartment Complex
                <br />
                Dhaka, Bangladesh
            </p>

        </div>





        <!-- Office Hours -->

        <div class="contact-card">

            <div class="icon">
                🕘
            </div>

            <h3>
                Office Hours
            </h3>

            <p>
                Saturday - Thursday
            </p>

            <p>
                9:00 AM - 6:00 PM
            </p>

        </div>



    </div>





    <!-- Google Map -->

    <section class="map-section">

        <h2>
            Find Our Location
        </h2>


        <iframe src="https://www.google.com/maps?q=Dhaka,Bangladesh&output=embed"
                width="100%"
                height="350"
                style="border:0;"
                allowfullscreen=""
                loading="lazy">
        </iframe>


    </section>



</div>