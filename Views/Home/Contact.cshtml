@{ ViewData["Title"] = "Contact"; ViewData["BodyClass"] = "ab-contact-page"; }
<div class="ab-contact-shell">
    <section class="ab-contact-hero">
        <div class="container ab-contact-hero-grid">
            <div data-reveal>
                <span class="ab-eyebrow"><i></i> Resident support</span>
                <h1>Human help for <em>connected living.</em></h1>
                <p>Reach the ADHUNIK BARI management team for building support, resident services, or marketplace questions.</p>
                <div class="ab-contact-actions">
                    <a class="ab-button ab-button-primary" href="tel:+8801891985466"><i class="fa-solid fa-phone"></i>Call management</a>
                    <button type="button" class="ab-button ab-button-ghost-light" data-bs-toggle="modal" data-bs-target="#emailSupportModal">
                        <i class="fa-regular fa-envelope"></i>Email support
                    </button>
                </div>
            </div>
            <aside class="ab-contact-signal" data-reveal>
                <span><i></i> Support desk online</span>
                <strong>9:00</strong>
                <small>AM — 6:00 PM<br />Saturday to Thursday</small>
            </aside>
        </div>
    </section>
    <section class="ab-contact-details">
        <div class="container">
            <div class="ab-contact-grid">
                <article>
                    <span><i class="fa-solid fa-building-shield"></i></span>
                    <small>MANAGEMENT OFFICE</small>
                    <h2>ADHUNIK BARI</h2>
                    <p>Apartment Complex<br />Smart management team</p>
                </article>
                <article class="position-relative is-clickable">
                    <span><i class="fa-solid fa-phone"></i></span>
                    <small>PHONE</small>
                    <h2><a href="tel:+8801891985466" class="stretched-link text-decoration-none text-reset">+880 1891-985466</a></h2>
                    <p>Click to call directly<br />Available during office hours</p>
                </article>
                <article class="position-relative is-clickable" role="button" data-bs-toggle="modal" data-bs-target="#emailSupportModal" title="Click to send message or email">
                    <span><i class="fa-regular fa-envelope"></i></span>
                    <small>SUPPORT EMAIL</small>
                    <h2><span class="text-reset">abeshbarua2004@gmail.com</span></h2>
                    <p>Click to message or copy email<br />For resident &amp; property inquiries</p>
                </article>
                <article class="position-relative is-clickable">
                    <span><i class="fa-solid fa-location-dot"></i></span>
                    <small>LOCATION</small>
                    <h2><a href="https://www.google.com/maps/search/?api=1&amp;query=Ahsanullah+University+of+Science+and+Technology+Tejgaon+Dhaka" target="_blank" rel="noopener noreferrer" class="stretched-link text-decoration-none text-reset">Tejgaon, Dhaka</a></h2>
                    <p>Ahsanullah University of Science &amp; Technology<br />Dhaka, Bangladesh</p>
                </article>
            </div>
            <div class="ab-contact-map-wrap">
                <div>
                    <span class="ab-eyebrow"><i></i> Find the office</span>
                    <h2>Visit the management team.</h2>
                    <p>Our management team is based right at the <strong>Ahsanullah University of Science &amp; Technology (AUST)</strong> campus in Tejgaon, Dhaka.</p>
                    <div class="ab-map-address-box">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <div>
                            <strong>Ahsanullah University of Science &amp; Technology</strong>
                            <span>141 &amp; 142 Love Road, Tejgaon Industrial Area, Dhaka-1208</span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <a class="ab-button ab-button-primary" href="https://www.google.com/maps/search/?api=1&amp;query=Ahsanullah+University+of+Science+and+Technology+Tejgaon+Dhaka" target="_blank" rel="noopener noreferrer">
                            <i class="fa-solid fa-diamond-turn-right"></i> Open in Google Maps
                        </a>
                    </div>
                </div>
                <iframe class="ab-contact-map" title="Map showing Ahsanullah University of Science and Technology, Tejgaon, Dhaka" src="https://maps.google.com/maps?q=Ahsanullah%20University%20of%20Science%20and%20Technology&amp;t=&amp;z=17&amp;ie=UTF8&amp;iwloc=B&amp;output=embed" loading="lazy" allowfullscreen></iframe>
            </div>
        </div>
    </section>
</div>

<!-- Email Support Modal -->
<div class="modal fade" id="emailSupportModal" tabindex="-1" aria-labelledby="emailSupportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ab-modal-shell">
            <div class="modal-header border-0 pb-0">
                <div>
                    <span class="ab-eyebrow"><i></i> Direct Support</span>
                    <h4 class="modal-title fw-bold" id="emailSupportModalLabel">Contact ADHUNIK BARI</h4>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="ab-email-card mb-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Support Email</small>
                            <div class="fw-bold fs-6 text-dark" id="supportEmailText">abeshbarua2004@gmail.com</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" id="copyEmailBtn" onclick="copySupportEmail()">
                            <i class="fa-regular fa-copy me-1"></i> <span id="copyBtnText">Copy</span>
                        </button>
                    </div>
                    <div class="d-flex gap-2 mt-3 pt-3 border-top">
                        <a href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=abeshbarua2004@gmail.com&amp;su=ADHUNIK%20BARI%20Support%20Enquiry" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-light border flex-fill">
                            <i class="fa-brands fa-google text-danger me-1"></i> Open in Gmail
                        </a>
                        <a href="mailto:abeshbarua2004@gmail.com?subject=ADHUNIK%20BARI%20Support%20Enquiry" class="btn btn-sm btn-light border flex-fill">
                            <i class="fa-regular fa-envelope me-1"></i> Default Mail App
                        </a>
                    </div>
                </div>

                <div class="ab-modal-divider"><span>OR COMPOSE A MESSAGE</span></div>

                <form id="contactDirectForm" onsubmit="sendViaGmail(event)">
                    <div id="contactFormAlert" class="alert alert-success d-none mb-3" role="alert">
                        <span id="contactFormAlertText"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-1">Your Name</label>
                        <input type="text" class="form-control form-control-sm" required placeholder="Enter your full name" id="senderName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-1">Your Email</label>
                        <input type="email" class="form-control form-control-sm" required placeholder="name@example.com" id="senderEmail" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-1">Subject</label>
                        <input type="text" class="form-control form-control-sm" required placeholder="Apartment inquiry, support, etc." id="senderSubject" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1">Message</label>
                        <textarea class="form-control form-control-sm" rows="3" required placeholder="How can our management team assist you?" id="senderMessage"></textarea>
                    </div>
                    <button type="submit" class="ab-button ab-button-primary w-100 justify-content-center" id="sendMessageSubmitBtn">
                        <i class="fa-brands fa-google me-2"></i> Send Message via Gmail
                    </button>
                    <button type="button" class="btn btn-sm btn-link text-muted w-100 text-decoration-none mt-2" onclick="sendViaMailApp()">
                        <i class="fa-regular fa-envelope me-1"></i> Or send using default Mail app
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copySupportEmail() {
            navigator.clipboard.writeText('abeshbarua2004@gmail.com').then(function() {
                var btnText = document.getElementById('copyBtnText');
                var btn = document.getElementById('copyEmailBtn');
                if (btnText && btn) {
                    btnText.innerText = 'Copied!';
                    btn.classList.remove('btn-outline-success');
                    btn.classList.add('btn-success', 'text-white');
                    setTimeout(function() {
                        btnText.innerText = 'Copy';
                        btn.classList.add('btn-outline-success');
                        btn.classList.remove('btn-success', 'text-white');
                    }, 2000);
                }
            });
        }

        function getMessageDetails() {
            var name = document.getElementById('senderName').value.trim() || 'Visitor';
            var email = document.getElementById('senderEmail').value.trim() || 'Not provided';
            var subject = document.getElementById('senderSubject').value.trim() || 'Resident Support Inquiry';
            var message = document.getElementById('senderMessage').value.trim();

            if (!message) {
                alert('Please enter your message before sending.');
                return null;
            }

            return {
                subject: '[ADHUNIK BARI Support] ' + subject,
                body: 'From: ' + name + ' (' + email + ')\n\nMessage:\n' + message
            };
        }

        function sendViaGmail(e) {
            if (e) e.preventDefault();
            var details = getMessageDetails();
            if (!details) return;

            var gmailUrl = 'https://mail.google.com/mail/?view=cm&fs=1&to=abeshbarua2004@gmail.com&su=' 
                + encodeURIComponent(details.subject) 
                + '&body=' + encodeURIComponent(details.body);

            window.open(gmailUrl, '_blank');

            var alertBox = document.getElementById('contactFormAlert');
            var alertText = document.getElementById('contactFormAlertText');
            if (alertBox && alertText) {
                alertBox.className = 'alert alert-success mb-3';
                alertText.innerHTML = '<i class="fa-solid fa-check-circle me-1"></i> Gmail opened with your message pre-filled. Simply click <strong>Send</strong> in Gmail to deliver it to <strong>abeshbarua2004@gmail.com</strong>!';
                alertBox.classList.remove('d-none');
            }
            document.getElementById('contactDirectForm').reset();
        }

        function sendViaMailApp() {
            var details = getMessageDetails();
            if (!details) return;

            var mailtoUrl = 'mailto:abeshbarua2004@gmail.com?subject=' 
                + encodeURIComponent(details.subject) 
                + '&body=' + encodeURIComponent(details.body);

            window.location.href = mailtoUrl;

            var alertBox = document.getElementById('contactFormAlert');
            var alertText = document.getElementById('contactFormAlertText');
            if (alertBox && alertText) {
                alertBox.className = 'alert alert-success mb-3';
                alertText.innerHTML = '<i class="fa-solid fa-check-circle me-1"></i> Mail app opened with your message pre-filled. Simply click <strong>Send</strong> in your mail app!';
                alertBox.classList.remove('d-none');
            }
            document.getElementById('contactDirectForm').reset();
        }
    </script>
}
