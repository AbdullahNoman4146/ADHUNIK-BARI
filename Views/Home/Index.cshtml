@model ADHUNIK_BARI.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">

    <div class="hero-content">

        <span class="hero-badge">
            Smart Apartment Management
        </span>


        <h1>
            Live Smarter.
            <br>
            Manage Better.
        </h1>


        <p>
            ADHUNIK BARI connects residents,
            managers and communities into one
            intelligent platform.
        </p>


        <div class="hero-buttons">

            <a class="primary-btn"
               href="/Account/Login">
                Get Started
            </a>


            <a class="secondary-btn"
               href="#features">
                Explore Features
            </a>

        </div>

    </div>



 <div class="hero-visual">


<div class="hero-feature-card">


    <!-- Tabs -->
    <div class="feature-tabs">


        <button class="feature-tab active"
        onmouseenter="changeFeature('flat',this)"
        onclick="changeFeature('flat',this)">

            🏠 Flat Management

        </button>



        <button class="feature-tab"
        onmouseenter="changeFeature('notice',this)"
        onclick="changeFeature('notice',this)">

            📢 Smart Notices

        </button>



        <button class="feature-tab"
        onmouseenter="changeFeature('billing',this)"
        onclick="changeFeature('billing',this)">

            💳 Digital Billing

        </button>


    </div>




    <!-- Dynamic Content -->

    <div class="feature-content"
         id="featureCard">


        <div class="feature-icon"
             id="featureIcon">

            🏠

        </div>



        <h3 id="featureTitle">

            Flat Management

        </h3>



        <p id="featureDescription">

            Manage flats, residents and communities from one powerful management platform.

        </p>


    </div>


</div>


</div>


</section>

<section class="home-marketplace-section">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <div class="property-eyebrow"><i class="fa-solid fa-building-circle-check me-2"></i>Find your next home</div>
                <h2 class="fw-bold mb-1">Available Flats — To-Let &amp; For Sale</h2>
                <p class="text-muted mb-0">Explore the latest published properties in the ADHUNIK BARI community.</p>
            </div>
            <a asp-controller="Property" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">View all properties <i class="fa-solid fa-arrow-right ms-1"></i></a>
        </div>

        @if (Model.LatestPropertyListings.Count > 0)
        {
            <div class="public-property-grid home-property-grid">
                @foreach (var listing in Model.LatestPropertyListings)
                {
                    <partial name="_PublicPropertyCard" model="listing" />
                }
            </div>
        }
        else
        {
            <div class="home-marketplace-empty rounded-4 p-4 p-md-5 text-center">
                <i class="fa-solid fa-house-circle-check"></i>
                <p class="mb-0 mt-2 text-muted">New To-Let and For-Sale properties will appear here as they are published.</p>
            </div>
        }
    </div>
</section>



<section id="features"
         class="features-section">


<h2>
Smart Features For Modern Communities
</h2>


<div class="feature-grid">


<div class="feature-card">

<div class="icon">
🏠
</div>

<h3>
Flat Management
</h3>

<p>
Manage flats, residents and assignments easily.
</p>

</div>



<div class="feature-card">

<div class="icon">
💳
</div>

<h3>
Digital Billing
</h3>

<p>
Simplify apartment payment management.
</p>

</div>



<div class="feature-card">

<div class="icon">
📢
</div>

<h3>
Smart Notices
</h3>

<p>
Communicate instantly with residents.
</p>

</div>


</div>

</section>